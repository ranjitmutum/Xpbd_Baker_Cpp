{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
      "VCPKG_ROOT": "C:/vcpkg",
      "HTTP_PROXY": "http://127.0.0.1:7892",
      "HTTPS_PROXY": "http://127.0.0.1:7892",
      "NO_PROXY": "127.0.0.1,localhost"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": {
          "type": "PATH",
          "value": "${sourceDir}/vcpkg_installed"
        },
        "XPBD_BUILD_TESTS": "OFF",
        "XPBD_BUILD_CLI": "ON",
        "XPBD_BUILD_APP": "ON",
        "XPBD_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "vscode-windows-app",
      "displayName": "VS Code Windows App",
      "description": "使用 Visual Studio Build Tools 2022 编译桌面程序",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/vscode-windows-app",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vscode-windows-app-release",
      "displayName": "VS Code Windows App Release",
      "configurePreset": "vscode-windows-app",
      "configuration": "Release",
      "targets": [
        "xpbd_baker_app"
      ]
    }
  ]
}