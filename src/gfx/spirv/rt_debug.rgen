#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba16f) uniform image2D outputImage;
layout(set = 0, binding = 3, std430) readonly buffer IndexBuffer {
  uint indices[];
};
layout(set = 0, binding = 10, r32f) uniform image2D outputDepth;
layout(set = 0, binding = 14) uniform sampler2D environmentTexture;

struct EnvironmentAliasEntry {
  float acceptance;
  uint aliasIndex;
  float probability;
  float padding;
};

layout(set = 0, binding = 15, std430) readonly buffer EnvironmentBuffer {
  uvec4 environmentInfo;
  vec4 environmentParameters;
  vec4 environmentSunDirectionMoonMean;
  vec4 environmentMoonDirectionAngularRadius;
  vec4 environmentMoonPhaseLibration;
  vec4 environmentSunColorStrength;
  // x = Environment power, y = SunDisk power; z/w reserved.
  vec4 environmentLightPower;
  EnvironmentAliasEntry environmentAlias[];
};

struct EmissiveTriangleEntry {
  vec4 p0Probability;
  vec4 p1Acceptance;
  vec4 p2Area;
  vec4 emissionLuminance;
  uvec4 metadata;
  // xy = stable 64-bit light ID, z = sidedness flags, w = source primitive.
  uvec4 stableLightId;
};

layout(set = 0, binding = 16, std430) readonly buffer EmissiveTriangleBuffer {
  // Primitive count, positive-emitter count, layout revision, reserved.
  uvec4 emissiveInfo;
  EmissiveTriangleEntry emissiveTriangles[];
};
layout(set = 0, binding = 17, std430) readonly buffer PositionBuffer {
  float positions[];
};
layout(set = 0, binding = 18, std430) readonly buffer PreviousPositionBuffer {
  float previousPositions[];
};
struct InstanceMotionRecord {
  mat4 currentTransform;
  mat4 previousTransform;
  uvec4 metadata;
};
layout(set = 0, binding = 19, std430) readonly buffer InstanceMotionBuffer {
  InstanceMotionRecord instanceMotion[];
};
layout(set = 0, binding = 20, std430) readonly buffer MotionFrameBuffer {
  mat4 previousViewProj;
  uvec4 motionInfo;
};
layout(set = 0, binding = 21, rgba16f) uniform image2DArray outputAov;
layout(set = 0, binding = 22, rgba32f) uniform image2D outputStatistics;
layout(set = 0, binding = 23, rg32f) uniform image2D outputRrMotion;
layout(set = 0, binding = 24, r32f)
    uniform image2D outputRrSpecularHitDistance;
layout(set = 0, binding = 25, rgba16f)
    uniform image2D outputRrDiffuseAlbedo;
layout(set = 0, binding = 26, rgba16f)
    uniform image2D outputRrSpecularAlbedo;
layout(set = 0, binding = 27, rgba16f)
    uniform image2D outputRrNormalRoughness;
struct SurfaceOpticsGpu {
  vec4 parameters;
  vec4 attenuationColor;
};
layout(set = 0, binding = 28, std430) readonly buffer PrimitiveOpticsBuffer {
  SurfaceOpticsGpu primitiveOptics[];
};
layout(set = 0, binding = 29, r8)
    uniform image2D outputTransparencyAndComposition;
layout(set = 0, binding = 30, r8) uniform image2D outputReactiveMask;
layout(set = 0, binding = 31, r8) uniform image2D outputGuideValidity;

const int kAovGeometry = 0;
const int kAovShading = 1;
const int kAovDiffuseAlbedo = 2;
const int kAovSpecularAlbedo = 3;
const int kAovDiffuseRadiance = 4;
const int kAovSpecularRadiance = 5;
const int kAovMotion = 6;
const int kAovEmission = 7;
const int kAovTransparency = 8;
const int kAovSpecularHitDistance = 9;
const uint kOutputRrMotion = 1u << 10u;
const uint kOutputRrSpecularHitDistance = 1u << 11u;
const uint kOutputRrDiffuseAlbedo = 1u << 12u;
const uint kOutputRrSpecularAlbedo = 1u << 13u;
const uint kOutputRrNormalRoughness = 1u << 14u;
const uint kOutputStatistics = 1u << 15u;
const uint kOutputTransparencyAndComposition = 1u << 16u;
const uint kOutputReactiveMask = 1u << 17u;
const uint kOutputGuideValidity = 1u << 18u;

const uint kTransparentGuidePolicyOpaqueBehind = 0u;
const uint kTransparentGuidePolicyFrontCoverage = 1u;
const uint kTransparentGuidePolicyConservativeInvalid = 2u;
const uint kTransparentGuidePolicyV1 =
    kTransparentGuidePolicyFrontCoverage;

layout(push_constant) uniform PC {
  mat4 invViewProj;
  mat4 viewProj;
  vec4 cameraEnvironment;
  uvec4 sizeMode;
  uvec4 sampling;
  vec4 lightDirectionAmbient;
  vec4 lightColorIntensity;
  uvec4 depthLimits;
  vec4 integrator;
  vec4 cameraJitter;
} pc;

bool outputEnabled(uint bit) {
  return (floatBitsToUint(pc.cameraJitter.w) & bit) != 0u;
}

bool aovOutputEnabled(int layer) {
  return outputEnabled(1u << uint(layer));
}

struct PrimaryPayload {
  vec3 baseColor;
  float t;
  vec3 shadingNormal;
  float ggxAlpha;
  vec3 geometricNormal;
  float ior;
  vec3 f0;
  float transmission;
  vec3 emission;
  float opacity;
  vec4 attenuation;
  uvec4 status;
  // xy barycentrics, z uintBitsToFloat(instance id), w reserved.
  vec4 hitData;
  // x = cone width at the ray origin, y = angular spread.
  vec2 rayCone;
};

struct ShadowPayload {
  float visibility;
  float reserved;
  vec2 rayCone;
};

const uint kMaterialBlend = 1u << 2u;
const uint kSunBackgroundVisible = 1u << 4u;
const uint kMoonBackgroundVisible = 1u << 5u;
const uint kSunLightingEnabled = 1u << 6u;
const uint kMoonLightingEnabled = 1u << 7u;
const uint kSunCastsShadows = 1u << 8u;
const uint kMoonCastsShadows = 1u << 9u;
const uint kMoonSurfaceDetail = 1u << 10u;
const uint kMoonManualPhase = 1u << 11u;
const float kDeltaMirrorAlpha = 1.0e-6;
const float kMinFiniteGgxAlpha = 1.0e-4;

const uint kRngDomainCameraJitter = 0x43414d45u;
const uint kRngDomainAlphaCoverage = 0x414c5048u;
const uint kRngDomainLobeSelection = 0x4c4f4245u;
const uint kRngDomainDirection = 0x44495245u;
const uint kRngDomainEnvironment = 0x454e5652u;
const uint kRngDomainEmissive = 0x454d4954u;
const uint kRngDomainLightRegistry = 0x4c524547u;
const uint kRngDomainRussianRoulette = 0x52524f55u;
const uint kRngDomainVolume = 0x564f4c55u;
const uint kRngDomainRestir = 0x52535452u;

layout(location = 0) rayPayloadEXT PrimaryPayload payload;
layout(location = 1) rayPayloadEXT ShadowPayload shadowPayload;

struct EnvironmentSample {
  vec3 direction;
  float pdf;
  bool valid;
};

struct MeshLightSample {
  vec3 direction;
  float pdf;
  vec3 radiance;
  float distance;
  bool valid;
};

const uint kRtLightEnvironment = 0u;
const uint kRtLightSunDisk = 1u;
const uint kRtLightEmissiveTriangle = 2u;

struct RtLightSample {
  vec3 direction;
  float pdf;
  vec3 radiance;
  float distance;
  uint type;
  bool castsShadow;
  bool valid;
};

struct PathRngState {
  uint state;
  uint dimension;
};

struct RayCone {
  float width;
  float spreadAngle;
};

uint hashPathTraceWord(uint value) {
  value ^= value >> 16u;
  value *= 0x7feb352du;
  value ^= value >> 15u;
  value *= 0x846ca68bu;
  value ^= value >> 16u;
  return value;
}

uint randomBits(uvec2 pixel, uint sampleIndex, uint dimension, uint seed) {
  uint state = hashPathTraceWord(seed ^ 0x9e3779b9u);
  state = hashPathTraceWord(state ^ pixel.x);
  state = hashPathTraceWord(state ^ (pixel.y + 0x85ebca6bu));
  state = hashPathTraceWord(state ^ (sampleIndex + 0xc2b2ae35u));
  return hashPathTraceWord(state ^ (dimension + 0x27d4eb2fu));
}

PathRngState makePathRng(uvec2 pixel, uint sampleIndex, uint bounce,
                         uint domain, uint stream, uint seed) {
  uint domainKey = hashPathTraceWord(domain);
  domainKey = hashPathTraceWord(domainKey ^ (bounce + 0x68bc21ebu));
  domainKey = hashPathTraceWord(domainKey ^ (stream + 0x02e5be93u));
  PathRngState rng;
  rng.state = randomBits(pixel, sampleIndex, domainKey, seed);
  rng.dimension = 0u;
  return rng;
}

uint nextRandomBits(inout PathRngState rng) {
  rng.state = hashPathTraceWord(
      rng.state ^ (rng.dimension + 0x9e3779b9u));
  ++rng.dimension;
  return rng.state;
}

float nextRandom(inout PathRngState rng) {
  return float(nextRandomBits(rng) >> 8u) * (1.0 / 16777216.0);
}

bool finite3(vec3 value) {
  return all(equal(value, value)) &&
         all(lessThanEqual(abs(value), vec3(65504.0)));
}

bool finite4(vec4 value) {
  return all(equal(value, value)) &&
         all(lessThanEqual(abs(value), vec4(65504.0)));
}

vec3 safeNormalize(vec3 value, vec3 fallback) {
  float lengthSquared = dot(value, value);
  return finite3(value) && lengthSquared > 1.0e-12
             ? value * inversesqrt(lengthSquared)
             : fallback;
}

bool finitePosition3(vec3 value) {
  return !any(isnan(value)) && !any(isinf(value));
}

vec3 offsetRayOrigin(vec3 position, vec3 geometricNormal,
                     vec3 outgoingDirection) {
  if (!finitePosition3(position) || !finitePosition3(geometricNormal) ||
      !finitePosition3(outgoingDirection)) {
    return position;
  }
  vec3 orientedNormal =
      safeNormalize(geometricNormal, vec3(0.0, 1.0, 0.0));
  if (dot(orientedNormal, outgoingDirection) < 0.0) {
    orientedNormal = -orientedNormal;
  }

  const float nearOrigin = 1.0 / 32.0;
  const float nearScale = 1.0 / 65536.0;
  const float ulpScale = 256.0;
  ivec3 ulps = ivec3(ulpScale * orientedNormal);
  vec3 candidate;
  for (int component = 0; component < 3; ++component) {
    if (abs(position[component]) < nearOrigin) {
      candidate[component] =
          position[component] + nearScale * orientedNormal[component];
    } else {
      int bits = floatBitsToInt(position[component]);
      bits += position[component] < 0.0 ? -ulps[component]
                                        : ulps[component];
      candidate[component] = intBitsToFloat(bits);
    }
  }
  vec3 movement = candidate - position;
  if (finitePosition3(candidate) && dot(movement, orientedNormal) > 0.0) {
    return candidate;
  }

  vec3 absolutePosition = abs(position);
  float sceneScale =
      max(1.0, max(absolutePosition.x,
                   max(absolutePosition.y, absolutePosition.z)));
  float fallbackDistance =
      max(nearScale, sceneScale * 1.1920928955078125e-7 * 4.0);
  vec3 fallbackPosition = position + orientedNormal * fallbackDistance;
  return finitePosition3(fallbackPosition) ? fallbackPosition : position;
}

vec3 cameraRayDirection(vec2 uv) {
  vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
  vec4 farWorldH = pc.invViewProj * vec4(ndc, 1.0, 1.0);
  vec3 farWorld =
      farWorldH.xyz / max(abs(farWorldH.w), 1.0e-6);
  return safeNormalize(farWorld - pc.cameraEnvironment.xyz,
                       vec3(0.0, 0.0, -1.0));
}

RayCone initialRayCone(vec2 uv, vec3 direction) {
  vec2 inverseSize = 1.0 / max(vec2(pc.sizeMode.xy), vec2(1.0));
  // Do not clamp the adjacent projected rays at the viewport edge. The
  // inverse projection remains valid just outside the viewport and preserves
  // a non-zero one-sided footprint for the rightmost/bottommost pixels.
  vec3 directionX = cameraRayDirection(
      uv + vec2(inverseSize.x, 0.0));
  vec3 directionY = cameraRayDirection(
      uv + vec2(0.0, inverseSize.y));
  float spread = max(
      acos(clamp(dot(direction, directionX), -1.0, 1.0)),
      acos(clamp(dot(direction, directionY), -1.0, 1.0)));
  RayCone cone;
  cone.width = 0.0;
  cone.spreadAngle = finitePosition3(vec3(spread)) ? spread : 0.0;
  return cone;
}

float rayConeWidthAtDistance(RayCone cone, float distance) {
  return max(cone.width, 0.0) +
         abs(distance) * max(cone.spreadAngle, 0.0);
}

RayCone propagateRayCone(RayCone cone, float distance, uint lobe,
                         float ggxAlpha, float etaRatio) {
  cone.width = rayConeWidthAtDistance(cone, distance);
  float alpha = clamp(ggxAlpha, 0.0, 1.0);
  float lobeSpread = 0.0;
  if (lobe == 0u) {
    lobeSpread = 0.5;
  } else if (lobe == 1u) {
    lobeSpread = 0.5 * sqrt(alpha);
  } else if (lobe == 2u) {
    lobeSpread =
        0.25 * sqrt(alpha) + 0.05 * abs(etaRatio - 1.0);
  }
  cone.spreadAngle =
      min(1.5707963267948966,
          max(max(cone.spreadAngle, 0.0), lobeSpread));
  return cone;
}

float rayConeEnvironmentLod(RayCone cone) {
  ivec2 extent = textureSize(environmentTexture, 0);
  float texels = max(cone.spreadAngle, 0.0) *
                 float(max(extent.x, extent.y));
  return texels > 1.0 ? max(log2(texels), 0.0) : 0.0;
}

float max3(vec3 value) {
  return max(value.x, max(value.y, value.z));
}

float luminance(vec3 value) {
  return dot(value, vec3(0.2126, 0.7152, 0.0722));
}

bool integratorFlag(uint bit) {
  return (pc.sampling.w & (1u << bit)) != 0u;
}

vec3 clampContribution(vec3 value, float limit) {
  if (!(limit > 0.0)) {
    return value;
  }
  float peak = max3(max(value, vec3(0.0)));
  return peak > limit ? value * (limit / peak) : value;
}

float powerHeuristic(float sampledPdf, float otherPdf) {
  float a = max(sampledPdf, 0.0);
  float b = max(otherPdf, 0.0);
  float scale = max(a, b);
  if (!(scale > 0.0)) {
    return 0.0;
  }
  a /= scale;
  b /= scale;
  float aSquared = a * a;
  float bSquared = b * b;
  return aSquared / max(aSquared + bSquared, 1.0e-20);
}

vec3 sampleUniformSphere(float sampleU, float sampleV) {
  float y = 1.0 - 2.0 * clamp(sampleU, 0.0, 0.99999994);
  float radius = sqrt(max(0.0, 1.0 - y * y));
  float angle = 6.28318530718 * clamp(sampleV, 0.0, 0.99999994);
  return vec3(radius * cos(angle), y, radius * sin(angle));
}

vec3 cosineHemisphere(vec3 normal, float sampleU, float sampleV) {
  float radius = sqrt(clamp(sampleU, 0.0, 0.99999994));
  float angle = 6.28318530718 * clamp(sampleV, 0.0, 0.99999994);
  vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0)
                                 : vec3(0.0, 1.0, 0.0);
  vec3 tangent = safeNormalize(cross(up, normal), vec3(1.0, 0.0, 0.0));
  vec3 bitangent = cross(normal, tangent);
  return safeNormalize(
      tangent * (radius * cos(angle)) +
          bitangent * (radius * sin(angle)) +
          normal * sqrt(max(0.0, 1.0 - sampleU)),
      normal);
}

float ggxDistribution(float normalDotHalf, float ggxAlpha) {
  float noH = clamp(normalDotHalf, 0.0, 1.0);
  if (!(noH > 0.0) || ggxAlpha <= kDeltaMirrorAlpha) {
    return 0.0;
  }
  float alpha = clamp(ggxAlpha, kMinFiniteGgxAlpha, 1.0);
  float alphaSquared = alpha * alpha;
  float denominator =
      noH * noH * (alphaSquared - 1.0) + 1.0;
  return alphaSquared /
         max(3.14159265358979323846 * denominator * denominator,
             1.0e-12);
}

float smithGgxG1(float normalDotDirection, float ggxAlpha) {
  float cosine = clamp(normalDotDirection, 0.0, 1.0);
  if (!(cosine > 0.0) || ggxAlpha <= kDeltaMirrorAlpha) {
    return 0.0;
  }
  float alpha = clamp(ggxAlpha, kMinFiniteGgxAlpha, 1.0);
  float root = sqrt(alpha * alpha +
                    (1.0 - alpha * alpha) * cosine * cosine);
  return 2.0 * cosine / max(cosine + root, 1.0e-8);
}

vec3 fresnelSchlick(vec3 f0, float cosine) {
  float factor = pow(1.0 - clamp(cosine, 0.0, 1.0), 5.0);
  return clamp(f0, vec3(0.0), vec3(1.0)) +
         (vec3(1.0) - clamp(f0, vec3(0.0), vec3(1.0))) *
             factor;
}

float dielectricFresnel(float cosineIncident, float etaIncident,
                        float etaTransmitted) {
  float cosI = clamp(abs(cosineIncident), 0.0, 1.0);
  float sinT = etaIncident / etaTransmitted *
               sqrt(max(0.0, 1.0 - cosI * cosI));
  if (sinT >= 1.0) {
    return 1.0;
  }
  float cosT = sqrt(max(0.0, 1.0 - sinT * sinT));
  float s = (etaTransmitted * cosI - etaIncident * cosT) /
            max(etaTransmitted * cosI + etaIncident * cosT, 1.0e-8);
  float p = (etaIncident * cosI - etaTransmitted * cosT) /
            max(etaIncident * cosI + etaTransmitted * cosT, 1.0e-8);
  return clamp(0.5 * (s * s + p * p), 0.0, 1.0);
}

void lobeProbabilities(vec3 baseColor, vec3 f0, bool metal,
                       float transmission, float ior,
                       out vec3 probabilities) {
  float normalFresnel =
      metal ? clamp(max3(f0), 0.0, 0.99)
            : dielectricFresnel(1.0, 1.0, ior);
  float diffuseImportance =
      metal ? 0.0
            : (1.0 - transmission) * (1.0 - normalFresnel) *
                  max(luminance(baseColor), 0.05);
  float interfaceImportance =
      metal ? max(normalFresnel, 0.02)
            : normalFresnel + transmission * (1.0 - normalFresnel);
  float total = diffuseImportance + interfaceImportance;
  if (!(total > 1.0e-8)) {
    probabilities = vec3(0.0, 1.0, 0.0);
    return;
  }
  float diffuseProbability = diffuseImportance / total;
  float interfaceProbability = interfaceImportance / total;
  float reflectionWeight = metal ? 1.0 : normalFresnel;
  float transmissionWeight =
      metal ? 0.0 : transmission * (1.0 - normalFresnel);
  float interfaceTotal = reflectionWeight + transmissionWeight;
  float reflectionProbability =
      interfaceTotal > 0.0
          ? interfaceProbability * reflectionWeight / interfaceTotal
          : interfaceProbability;
  probabilities = vec3(
      diffuseProbability, reflectionProbability,
      max(0.0, interfaceProbability - reflectionProbability));
}

float ggxVisibleNormalPdf(vec3 normal, vec3 view, vec3 halfVector,
                          float ggxAlpha) {
  if (ggxAlpha <= kDeltaMirrorAlpha) {
    return 0.0;
  }
  float noV = dot(normal, view);
  float noH = dot(normal, halfVector);
  float voH = dot(view, halfVector);
  if (!(noV > 0.0) || !(noH > 0.0) || !(voH > 0.0)) {
    return 0.0;
  }
  return ggxDistribution(noH, ggxAlpha) *
         smithGgxG1(noV, ggxAlpha) * voH / noV;
}

vec3 sampleGgxVndf(vec3 normal, vec3 view, float ggxAlpha,
                   float sampleU, float sampleV, out bool valid) {
  valid = false;
  if (ggxAlpha <= kDeltaMirrorAlpha || !(dot(normal, view) > 0.0)) {
    return normal;
  }
  vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0)
                                  : vec3(0.0, 1.0, 0.0);
  vec3 tangent = safeNormalize(cross(up, normal), vec3(1.0, 0.0, 0.0));
  vec3 bitangent = cross(normal, tangent);
  vec3 localView = vec3(dot(view, tangent), dot(view, bitangent),
                        dot(view, normal));
  float alpha = clamp(ggxAlpha, kMinFiniteGgxAlpha, 1.0);
  vec3 stretchedView = safeNormalize(
      vec3(alpha * localView.x, alpha * localView.y, localView.z),
      vec3(0.0, 0.0, 1.0));
  float lensq = dot(stretchedView.xy, stretchedView.xy);
  vec3 basisX = lensq > 1.0e-20
                    ? vec3(-stretchedView.y, stretchedView.x, 0.0) /
                          sqrt(lensq)
                    : vec3(1.0, 0.0, 0.0);
  vec3 basisY = cross(stretchedView, basisX);
  float radius = sqrt(clamp(sampleU, 0.0, 0.99999994));
  float phi = 6.28318530718 * clamp(sampleV, 0.0, 0.99999994);
  float diskX = radius * cos(phi);
  float diskY = radius * sin(phi);
  float blend = 0.5 * (1.0 + stretchedView.z);
  diskY = (1.0 - blend) * sqrt(max(0.0, 1.0 - diskX * diskX)) +
          blend * diskY;
  float diskZ = sqrt(max(0.0, 1.0 - diskX * diskX - diskY * diskY));
  vec3 stretchedNormal =
      diskX * basisX + diskY * basisY + diskZ * stretchedView;
  vec3 localHalf = safeNormalize(
      vec3(alpha * stretchedNormal.x, alpha * stretchedNormal.y,
           max(stretchedNormal.z, 0.0)),
      vec3(0.0, 0.0, 1.0));
  vec3 halfVector = safeNormalize(
      tangent * localHalf.x + bitangent * localHalf.y + normal * localHalf.z,
      normal);
  valid = ggxVisibleNormalPdf(normal, view, halfVector, ggxAlpha) > 0.0 &&
          finite3(halfVector);
  return halfVector;
}

void evaluateBsdfComponents(
    vec3 baseColor, vec3 f0, vec3 reflectionTint, float ggxAlpha,
    float transmission, float ior, bool metal, bool thinWalled, bool frontFace,
    vec3 normal, vec3 view, vec3 light, out vec3 diffuse,
    out vec3 specular, out float pdf) {
  pdf = 0.0;
  diffuse = vec3(0.0);
  specular = vec3(0.0);
  float noV = dot(normal, view);
  float noL = dot(normal, light);
  if (!(noV > 0.0) || !(noL > 0.0)) {
    return;
  }
  vec3 halfVector = safeNormalize(view + light, normal);
  float noH = max(dot(normal, halfVector), 0.0);
  float voH = max(dot(view, halfVector), 0.0);
  if (!(noH > 0.0) || !(voH > 0.0)) {
    return;
  }
  bool deltaInterface =
      ggxAlpha <= kDeltaMirrorAlpha ||
      (!metal && thinWalled && transmission > 0.0);
  float distribution = 0.0;
  float geometry = 0.0;
  if (!deltaInterface) {
    distribution = ggxDistribution(noH, ggxAlpha);
    geometry =
        smithGgxG1(noV, ggxAlpha) * smithGgxG1(noL, ggxAlpha);
  }
  float etaIncident = frontFace ? 1.0 : ior;
  float etaTransmitted = frontFace ? ior : 1.0;
  vec3 fresnel = metal
                     ? fresnelSchlick(f0, voH)
                     : vec3(dielectricFresnel(
                           voH, etaIncident, etaTransmitted));
  float scalarFresnel = max3(fresnel);
  specular =
      deltaInterface
          ? vec3(0.0)
          : reflectionTint * fresnel * distribution * geometry /
                max(4.0 * noV * noL, 1.0e-8);
  diffuse =
      metal ? vec3(0.0)
             : baseColor * (1.0 - transmission) *
                  (1.0 - scalarFresnel) *
                  (1.0 / 3.14159265358979323846);
  vec3 probabilities;
  lobeProbabilities(baseColor, f0, metal, transmission, ior,
                    probabilities);
  float diffusePdf = noL * (1.0 / 3.14159265358979323846);
  float interfaceProbability = probabilities.y + probabilities.z;
  float reflectionWeight = metal ? 1.0 : scalarFresnel;
  float transmissionWeight =
      metal ? 0.0 : transmission * (1.0 - scalarFresnel);
  float interfaceTotal = reflectionWeight + transmissionWeight;
  float conditionalReflection =
      interfaceTotal > 0.0 ? reflectionWeight / interfaceTotal : 1.0;
  float glossyPdf =
      deltaInterface
          ? 0.0
          : interfaceProbability * conditionalReflection *
                ggxVisibleNormalPdf(normal, view, halfVector, ggxAlpha) /
                max(4.0 * abs(voH), 1.0e-8);
  pdf = probabilities.x * diffusePdf +
        glossyPdf;
}

vec3 evaluateBsdf(vec3 baseColor, vec3 f0, vec3 reflectionTint,
                  float ggxAlpha, float transmission, float ior,
                  bool metal, bool thinWalled, bool frontFace, vec3 normal,
                  vec3 view, vec3 light, out float pdf) {
  vec3 diffuse;
  vec3 specular;
  evaluateBsdfComponents(
      baseColor, f0, reflectionTint, ggxAlpha, transmission, ior,
      metal, thinWalled, frontFace, normal, view,
      light, diffuse, specular, pdf);
  return diffuse + specular;
}

vec3 evaluateMicrofacetTransmission(
    vec3 baseColor, float ggxAlpha, float transmission, float ior,
    bool frontFace, vec3 normal, vec3 view, vec3 light, out float pdf) {
  pdf = 0.0;
  float noV = dot(normal, view);
  float noL = dot(normal, light);
  if (!(noV > 0.0) || !(noL < 0.0) || !(transmission > 0.0) ||
      ggxAlpha <= kDeltaMirrorAlpha) {
    return vec3(0.0);
  }
  float etaIncident = frontFace ? 1.0 : ior;
  float etaTransmitted = frontFace ? ior : 1.0;
  float etaPath = etaTransmitted / etaIncident;
  vec3 halfVector = safeNormalize(light * etaPath + view, normal);
  if (dot(halfVector, normal) < 0.0) {
    halfVector = -halfVector;
  }
  float noH = dot(normal, halfVector);
  float voH = dot(view, halfVector);
  float loH = dot(light, halfVector);
  if (!(noH > 0.0) || !(voH > 0.0) || !(loH < 0.0)) {
    return vec3(0.0);
  }
  float fresnel = dielectricFresnel(
      voH, etaIncident, etaTransmitted);
  float transmissionWeight = transmission * (1.0 - fresnel);
  float interfaceTotal = fresnel + transmissionWeight;
  if (!(interfaceTotal > 0.0)) {
    return vec3(0.0);
  }
  float denominator = loH + voH / etaPath;
  float denominatorSquared = denominator * denominator;
  float dwmDwi = abs(loH) / max(denominatorSquared, 1.0e-8);
  vec3 probabilities;
  lobeProbabilities(baseColor, vec3(0.04), false, transmission, ior,
                    probabilities);
  float interfaceProbability = probabilities.y + probabilities.z;
  pdf = interfaceProbability * transmissionWeight / interfaceTotal *
        ggxVisibleNormalPdf(normal, view, halfVector, ggxAlpha) * dwmDwi;
  float distribution = ggxDistribution(noH, ggxAlpha);
  float geometry = smithGgxG1(noV, ggxAlpha) *
                   smithGgxG1(-noL, ggxAlpha);
  float etaScale = 1.0 / (etaPath * etaPath);
  float value = transmissionWeight * distribution * geometry *
                abs(loH * voH /
                    (max(denominatorSquared, 1.0e-8) * noL * noV)) *
                etaScale;
  return vec3(max(value, 0.0));
}

float thinWalledCombinedFresnel(float fresnel) {
  float clamped = clamp(fresnel, 0.0, 1.0);
  return clamp(2.0 * clamped / (1.0 + clamped), 0.0, 1.0);
}

vec3 beerLambertTransmittance(vec3 attenuationColor,
                              float attenuationDistance,
                              float traveledDistance) {
  if (!(attenuationDistance > 0.0) || !(traveledDistance > 0.0)) {
    return vec3(1.0);
  }
  vec3 color = clamp(attenuationColor, vec3(1.0e-6), vec3(1.0));
  vec3 sigmaA = -log(color) / attenuationDistance;
  vec3 transmittance = exp(-sigmaA * traveledDistance);
  return finite3(transmittance)
             ? clamp(transmittance, vec3(0.0), vec3(1.0))
             : vec3(0.0);
}

float shadingNormalCorrection(vec3 geometricNormal, vec3 shadingNormal,
                               vec3 view, vec3 light) {
  const float kCorrectionLimit = 4.0;
  float viewGeometric = dot(view, geometricNormal);
  float viewShading = dot(view, shadingNormal);
  float lightGeometric = dot(light, geometricNormal);
  float lightShading = dot(light, shadingNormal);
  if (viewGeometric * viewShading <= 0.0 ||
      lightGeometric * lightShading <= 0.0 ||
      abs(lightGeometric * viewShading) <= 1.0e-8) {
    return 0.0;
  }
  return clamp(
      abs((lightShading * viewGeometric) /
          (lightGeometric * viewShading)),
      0.0, kCorrectionLimit);
}

vec3 analyticEnvironment(vec3 direction) {
  float strength = max(pc.cameraEnvironment.w, 0.0);
  if (!(strength > 0.0)) {
    return vec3(0.0);
  }
  float elevation = clamp(direction.y * 0.5 + 0.5, 0.0, 1.0);
  vec3 horizon = vec3(0.42, 0.55, 0.72);
  vec3 zenith = vec3(0.08, 0.20, 0.48);
  vec3 sky = mix(horizon, zenith, pow(elevation, 0.65));
  return strength * sky;
}

bool hdrEnvironmentEnabled() {
  return (pc.sampling.w & (1u << 24u)) != 0u;
}

bool hdrEnvironmentValid() {
  return hdrEnvironmentEnabled() &&
         (environmentInfo.x & 1u) != 0u &&
         environmentInfo.y > 0u && environmentInfo.z > 0u &&
         environmentInfo.w ==
             environmentInfo.y * environmentInfo.z;
}

bool proceduralMoonEnabled(bool background) {
  uint requiredFlag =
      background ? kMoonBackgroundVisible : kMoonLightingEnabled;
  return hdrEnvironmentValid() &&
         (environmentInfo.x & 8u) != 0u &&
         (environmentInfo.x & requiredFlag) != 0u &&
         environmentMoonDirectionAngularRadius.w > 0.0 &&
         environmentSunDirectionMoonMean.w > 0.0;
}

vec3 environmentCacheDirection(vec3 direction) {
  vec3 unitDirection =
      safeNormalize(direction, vec3(0.0, 1.0, 0.0));
  float cosine = cos(environmentParameters.z);
  float sine = sin(environmentParameters.z);
  return vec3(unitDirection.x * cosine - unitDirection.z * sine,
              unitDirection.y,
              unitDirection.z * cosine + unitDirection.x * sine);
}

vec2 environmentUv(vec3 direction) {
  vec3 unitDirection =
      safeNormalize(direction, vec3(0.0, 1.0, 0.0));
  float phi =
      atan(unitDirection.x, unitDirection.z) - environmentParameters.z;
  float u = fract(phi * (1.0 / 6.28318530718));
  float v = acos(clamp(unitDirection.y, -1.0, 1.0)) *
            (1.0 / 3.14159265358979323846);
  return vec2(u, clamp(v, 0.0, 0.99999994));
}

float moonValueNoise(vec3 position) {
  ivec3 cell = ivec3(floor(position));
  vec3 fraction = fract(position);
  vec3 smoothFraction =
      fraction * fraction * (3.0 - 2.0 * fraction);
  float values[8];
  for (int z = 0; z <= 1; ++z) {
    for (int y = 0; y <= 1; ++y) {
      for (int x = 0; x <= 1; ++x) {
        ivec3 point = cell + ivec3(x, y, z);
        uint packed =
            uint(point.x) * 0x9e3779b9u ^
            uint(point.y) * 0x85ebca6bu ^
            uint(point.z) * 0xc2b2ae35u;
        values[x + 2 * y + 4 * z] =
            float(hashPathTraceWord(packed)) *
            (1.0 / 4294967296.0);
      }
    }
  }
  float x00 = mix(values[0], values[1], smoothFraction.x);
  float x10 = mix(values[2], values[3], smoothFraction.x);
  float x01 = mix(values[4], values[5], smoothFraction.x);
  float x11 = mix(values[6], values[7], smoothFraction.x);
  return mix(mix(x00, x10, smoothFraction.y),
             mix(x01, x11, smoothFraction.y), smoothFraction.z);
}

float moonFbm(vec3 position) {
  float value = 0.0;
  float weight = 0.5;
  for (int octave = 0; octave < 4; ++octave) {
    value += moonValueNoise(position) * weight;
    position = position * 2.03 + vec3(7.1, 3.7, 5.9);
    weight *= 0.5;
  }
  return value;
}

vec3 rotateLunarSurface(vec3 normal) {
  float latitude = environmentMoonPhaseLibration.z;
  float longitude = environmentMoonPhaseLibration.w;
  float cosLatitude = cos(latitude);
  float sinLatitude = sin(latitude);
  normal.yz =
      mat2(cosLatitude, -sinLatitude,
           sinLatitude, cosLatitude) * normal.yz;
  float cosLongitude = cos(longitude);
  float sinLongitude = sin(longitude);
  normal.xz =
      mat2(cosLongitude, -sinLongitude,
           sinLongitude, cosLongitude) * normal.xz;
  return normal;
}

float lunarAlbedo(vec3 surfaceNormal) {
  if ((environmentInfo.x & kMoonSurfaceDetail) == 0u) {
    return 0.10;
  }
  vec3 mapped = rotateLunarSurface(surfaceNormal);
  float terrain = moonFbm(mapped * 18.0);
  float maria =
      moonFbm(mapped * 5.0 + vec3(17.0, 3.0, 11.0));
  return clamp(
      0.075 + terrain * 0.055 -
          smoothstep(0.58, 0.78, maria) * 0.035,
      0.045, 0.16);
}

vec3 proceduralMoonRadiance(vec3 direction, bool background) {
  if (!proceduralMoonEnabled(background)) {
    return vec3(0.0);
  }
  vec3 cacheDirection = environmentCacheDirection(direction);
  vec3 moonDirection = safeNormalize(
      environmentMoonDirectionAngularRadius.xyz,
      vec3(0.0, 1.0, 0.0));
  float angularRadius =
      max(environmentMoonDirectionAngularRadius.w, 1.0e-6);
  if (dot(cacheDirection, moonDirection) < cos(angularRadius)) {
    return vec3(0.0);
  }
  float sineRadius = max(sin(angularRadius), 1.0e-6);
  vec3 tangentX = cross(vec3(0.0, 1.0, 0.0), moonDirection);
  if (dot(tangentX, tangentX) < 1.0e-6) {
    tangentX = cross(vec3(1.0, 0.0, 0.0), moonDirection);
  }
  tangentX = safeNormalize(tangentX, vec3(1.0, 0.0, 0.0));
  vec3 tangentY =
      safeNormalize(cross(moonDirection, tangentX),
                    vec3(0.0, 1.0, 0.0));
  float diskX = dot(cacheDirection, tangentX) / sineRadius;
  float diskY = dot(cacheDirection, tangentY) / sineRadius;
  float radialSquared =
      clamp(diskX * diskX + diskY * diskY, 0.0, 1.0);
  vec3 surfaceNormal = safeNormalize(
      tangentX * diskX + tangentY * diskY -
          moonDirection * sqrt(max(1.0 - radialSquared, 0.0)),
      -moonDirection);
  vec3 sunDirection = safeNormalize(
      environmentSunDirectionMoonMean.xyz,
      vec3(0.0, 1.0, 0.0));
  if ((environmentInfo.x & kMoonManualPhase) != 0u) {
    float phaseAngle =
        clamp(environmentMoonPhaseLibration.y, 0.0,
              3.14159265358979323846);
    sunDirection = safeNormalize(
        -moonDirection * cos(phaseAngle) +
            tangentX * sin(phaseAngle),
        sunDirection);
  }
  float directLight = max(dot(surfaceNormal, sunDirection), 0.0);
  float earthshine =
      0.0025 * (1.0 - environmentMoonPhaseLibration.x);
  float albedo = lunarAlbedo(surfaceNormal);
  const vec3 solarIrradiance = vec3(
      1.474000, 1.850400, 1.911980);
  vec3 rawRadiance =
      solarIrradiance * (albedo / 3.14159265358979323846) *
      (directLight + earthshine);

  float phaseAngle =
      clamp(environmentMoonPhaseLibration.y, 0.0,
            3.14159265358979323846);
  float lambertPhase =
      (sin(phaseAngle) +
       (3.14159265358979323846 - phaseAngle) *
           cos(phaseAngle)) *
      (1.0 / 3.14159265358979323846);
  float meanRawLuminance =
      luminance(solarIrradiance) *
      (0.10 / 3.14159265358979323846) *
      ((2.0 / 3.0) * max(lambertPhase, 0.0) + earthshine);
  float attenuation =
      clamp(environmentSunDirectionMoonMean.w /
                max(meanRawLuminance, 1.0e-8),
            0.0, 1.0);
  vec3 radiance = rawRadiance * attenuation;
  return finite3(radiance) ? min(radiance, vec3(65504.0))
                           : vec3(0.0);
}

vec3 proceduralSunRadiance(vec3 direction, bool background) {
  uint requiredFlag =
      background ? kSunBackgroundVisible : kSunLightingEnabled;
  if (!hdrEnvironmentValid() ||
      (environmentInfo.x & requiredFlag) == 0u ||
      !(environmentParameters.w > 0.0) ||
      !(environmentSunColorStrength.w > 0.0)) {
    return vec3(0.0);
  }
  vec3 cacheDirection = environmentCacheDirection(direction);
  vec3 sunDirection = safeNormalize(
      environmentSunDirectionMoonMean.xyz,
      vec3(0.0, 1.0, 0.0));
  // A Sun below the horizon must not leak through the analytic ground blend.
  float horizonVisibility = smoothstep(-0.05, 0.02, sunDirection.y);
  if (!(horizonVisibility > 0.0)) {
    return vec3(0.0);
  }
  float angularRadius = max(environmentParameters.w, 1.0e-6);
  float cosine = dot(cacheDirection, sunDirection);
  float edgeCosine = cos(angularRadius);
  if (cosine < edgeCosine) {
    return vec3(0.0);
  }
  float angularDistance = acos(clamp(cosine, -1.0, 1.0));
  float radial = angularDistance / angularRadius;
  // The smooth edge keeps the disk circular while avoiding a hard pixel seam.
  float disk = 1.0 - smoothstep(0.94, 1.0, radial);
  vec3 solarRadiance =
      max(environmentSunColorStrength.rgb, vec3(0.0)) *
      (700.0 * environmentSunColorStrength.w) * disk *
      horizonVisibility;
  return finite3(solarRadiance) ? min(solarRadiance, vec3(65504.0))
                                : vec3(0.0);
}

vec3 hdrEnvironmentTexture(vec3 direction, bool background,
                           float textureLodValue) {
  if (!hdrEnvironmentValid()) {
    return vec3(0.0);
  }
  vec3 radiance =
      max(textureLod(environmentTexture, environmentUv(direction),
                     max(textureLodValue, 0.0)).rgb,
          vec3(0.0)) +
      (background ? proceduralSunRadiance(direction, true) : vec3(0.0)) +
      proceduralMoonRadiance(direction, background);
  return finite3(radiance) ? min(radiance, vec3(65504.0))
                           : vec3(0.0);
}

vec3 lightingEnvironment(vec3 direction, float textureLodValue) {
  if (hdrEnvironmentEnabled()) {
    if (!hdrEnvironmentValid() ||
        (environmentInfo.x & 4u) == 0u ||
        !(environmentParameters.x > 0.0)) {
      return vec3(0.0);
    }
    return min(hdrEnvironmentTexture(direction, false, textureLodValue) *
                   environmentParameters.x,
               vec3(65504.0));
  }
  return analyticEnvironment(direction);
}

vec3 backgroundEnvironment(vec3 direction, float textureLodValue) {
  if (hdrEnvironmentEnabled()) {
    if (!hdrEnvironmentValid() ||
        (environmentInfo.x & 2u) == 0u ||
        !(environmentParameters.y > 0.0)) {
      return vec3(0.0);
    }
    return min(hdrEnvironmentTexture(direction, true, textureLodValue) *
                   environmentParameters.y,
               vec3(65504.0));
  }
  return analyticEnvironment(direction);
}

bool environmentBackgroundVisible() {
  return hdrEnvironmentEnabled()
             ? hdrEnvironmentValid() &&
                   (environmentInfo.x & 2u) != 0u &&
                   environmentParameters.y > 0.0
             : pc.cameraEnvironment.w > 0.0;
}

float analyticEnvironmentPdf(vec3 direction) {
  return pc.cameraEnvironment.w > 0.0 && finite3(direction)
             ? 0.07957747154594767
             : 0.0;
}

float hdrEnvironmentPdf(vec3 direction) {
  if (!hdrEnvironmentValid() ||
      (environmentInfo.x & 4u) == 0u ||
      !(environmentParameters.x > 0.0)) {
    return 0.0;
  }
  vec2 uv = environmentUv(direction);
  uint x = min(uint(uv.x * float(environmentInfo.y)),
               environmentInfo.y - 1u);
  uint y = min(uint(uv.y * float(environmentInfo.z)),
               environmentInfo.z - 1u);
  uint index = y * environmentInfo.y + x;
  float theta0 = 3.14159265358979323846 *
                 float(y) / float(environmentInfo.z);
  float theta1 = 3.14159265358979323846 *
                 float(y + 1u) / float(environmentInfo.z);
  float solidAngle =
      (6.28318530718 / float(environmentInfo.y)) *
      (cos(theta0) - cos(theta1));
  return solidAngle > 0.0
             ? max(environmentAlias[index].probability, 0.0) /
                   solidAngle
             : 0.0;
}

float environmentPdf(vec3 direction) {
  if (!integratorFlag(29u)) {
    return length(lightingEnvironment(direction, 0.0)) > 0.0
               ? 0.07957747154594767
               : 0.0;
  }
  return hdrEnvironmentEnabled() ? hdrEnvironmentPdf(direction)
                                 : analyticEnvironmentPdf(direction);
}

bool environmentSampleCastsShadow(vec3 direction) {
  if (!hdrEnvironmentValid()) {
    return true;
  }
  vec3 cacheDirection = environmentCacheDirection(direction);
  if ((environmentInfo.x & kMoonLightingEnabled) != 0u &&
      environmentMoonDirectionAngularRadius.w > 0.0 &&
      dot(cacheDirection,
          safeNormalize(environmentMoonDirectionAngularRadius.xyz,
                        vec3(0.0, 1.0, 0.0))) >=
          cos(environmentMoonDirectionAngularRadius.w)) {
    return (environmentInfo.x & kMoonCastsShadows) != 0u;
  }
  return true;
}

EnvironmentSample sampleEnvironment(float columnSample, float coinSample,
                                    float jitterU, float jitterV) {
  EnvironmentSample result;
  result.direction = vec3(0.0, 1.0, 0.0);
  result.pdf = 0.0;
  result.valid = false;
  if (!integratorFlag(29u)) {
    result.direction = sampleUniformSphere(columnSample, coinSample);
    result.pdf = environmentPdf(result.direction);
    result.valid = result.pdf > 0.0;
    return result;
  }
  if (!hdrEnvironmentEnabled()) {
    result.direction = sampleUniformSphere(columnSample, coinSample);
    result.pdf = analyticEnvironmentPdf(result.direction);
    result.valid = result.pdf > 0.0;
    return result;
  }
  if (!hdrEnvironmentValid() ||
      (environmentInfo.x & 4u) == 0u ||
      !(environmentParameters.x > 0.0)) {
    return result;
  }
  float scaled =
      clamp(columnSample, 0.0, 0.99999994) *
      float(environmentInfo.w);
  uint column = min(uint(scaled), environmentInfo.w - 1u);
  EnvironmentAliasEntry columnEntry = environmentAlias[column];
  uint index =
      clamp(coinSample, 0.0, 0.99999994) <
              clamp(columnEntry.acceptance, 0.0, 1.0)
          ? column
          : min(columnEntry.aliasIndex, environmentInfo.w - 1u);
  uint x = index % environmentInfo.y;
  uint y = index / environmentInfo.y;
  float u = (float(x) + clamp(jitterU, 0.0, 0.99999994)) /
            float(environmentInfo.y);
  float v = (float(y) + clamp(jitterV, 0.0, 0.99999994)) /
            float(environmentInfo.z);
  float phi =
      6.28318530718 * u + environmentParameters.z;
  float theta = 3.14159265358979323846 * v;
  float sinTheta = sin(theta);
  result.direction =
      vec3(sinTheta * sin(phi), cos(theta), sinTheta * cos(phi));
  float theta0 = 3.14159265358979323846 *
                 float(y) / float(environmentInfo.z);
  float theta1 = 3.14159265358979323846 *
                 float(y + 1u) / float(environmentInfo.z);
  float solidAngle =
      (6.28318530718 / float(environmentInfo.y)) *
      (cos(theta0) - cos(theta1));
  result.pdf =
      solidAngle > 0.0
          ? max(environmentAlias[index].probability, 0.0) /
                solidAngle
          : 0.0;
  result.valid = result.pdf > 0.0 && finite3(result.direction);
  return result;
}

bool meshLightsValid() {
  return integratorFlag(30u) && emissiveInfo.x > 0u &&
         emissiveInfo.y > 0u && emissiveInfo.z == 2u;
}

vec3 emissiveTriangleNormal(EmissiveTriangleEntry entry) {
  return safeNormalize(
      cross(entry.p1Acceptance.xyz - entry.p0Probability.xyz,
            entry.p2Area.xyz - entry.p0Probability.xyz),
      vec3(0.0, 1.0, 0.0));
}

bool emissiveTriangleTwoSided(EmissiveTriangleEntry entry) {
  return (entry.stableLightId.z & 1u) != 0u;
}

float emissiveTriangleCosine(EmissiveTriangleEntry entry,
                             vec3 lightDirection) {
  float facing = dot(emissiveTriangleNormal(entry), -lightDirection);
  return emissiveTriangleTwoSided(entry) ? abs(facing) : max(facing, 0.0);
}

float meshLightPdf(uint primitive, vec3 source, vec3 lightPoint) {
  if (!meshLightsValid() || primitive >= emissiveInfo.x) {
    return 0.0;
  }
  EmissiveTriangleEntry entry = emissiveTriangles[primitive];
  float selectionPdf = max(entry.p0Probability.w, 0.0);
  float area = max(entry.p2Area.w, 0.0);
  if (entry.metadata.y == 0u || !(selectionPdf > 0.0) ||
      !(area > 0.0)) {
    return 0.0;
  }
  vec3 toLight = lightPoint - source;
  float distanceSquared = dot(toLight, toLight);
  if (!(distanceSquared > 1.0e-10)) {
    return 0.0;
  }
  vec3 lightDirection = toLight * inversesqrt(distanceSquared);
  float lightCosine = emissiveTriangleCosine(entry, lightDirection);
  return lightCosine > 1.0e-6
             ? selectionPdf * distanceSquared /
                   (area * lightCosine)
             : 0.0;
}

MeshLightSample sampleMeshLight(
    vec3 source, float columnSample, float coinSample,
    float triangleSampleU, float triangleSampleV) {
  MeshLightSample result;
  result.direction = vec3(0.0, 1.0, 0.0);
  result.pdf = 0.0;
  result.radiance = vec3(0.0);
  result.distance = 0.0;
  result.valid = false;
  if (!meshLightsValid()) {
    return result;
  }
  float scaled =
      clamp(columnSample, 0.0, 0.99999994) * float(emissiveInfo.x);
  uint column = min(uint(scaled), emissiveInfo.x - 1u);
  EmissiveTriangleEntry columnEntry = emissiveTriangles[column];
  uint selected =
      clamp(coinSample, 0.0, 0.99999994) <
              clamp(columnEntry.p1Acceptance.w, 0.0, 1.0)
          ? column
          : min(columnEntry.metadata.x, emissiveInfo.x - 1u);
  EmissiveTriangleEntry entry = emissiveTriangles[selected];
  if (entry.metadata.y == 0u || !(entry.p0Probability.w > 0.0) ||
      !(entry.p2Area.w > 0.0)) {
    return result;
  }
  float root = sqrt(clamp(triangleSampleU, 0.0, 0.99999994));
  float b0 = 1.0 - root;
  float b1 = root * (1.0 - clamp(triangleSampleV, 0.0, 0.99999994));
  float b2 = root * clamp(triangleSampleV, 0.0, 0.99999994);
  vec3 lightPoint =
      entry.p0Probability.xyz * b0 + entry.p1Acceptance.xyz * b1 +
      entry.p2Area.xyz * b2;
  vec3 toLight = lightPoint - source;
  float distanceSquared = dot(toLight, toLight);
  if (!(distanceSquared > 1.0e-10)) {
    return result;
  }
  result.distance = sqrt(distanceSquared);
  result.direction = toLight / result.distance;
  float lightCosine = emissiveTriangleCosine(entry, result.direction);
  result.pdf =
      lightCosine > 1.0e-6
          ? entry.p0Probability.w * distanceSquared /
                (entry.p2Area.w * lightCosine)
          : 0.0;
  result.radiance = max(entry.emissionLuminance.rgb, vec3(0.0));
  result.valid = result.pdf > 0.0 && max3(result.radiance) > 0.0 &&
                 finite3(result.direction) && finite3(result.radiance);
  return result;
}

bool environmentLightEnabled() {
  if (hdrEnvironmentEnabled()) {
    return hdrEnvironmentValid() && (environmentInfo.x & 4u) != 0u &&
           environmentParameters.x > 0.0;
  }
  return pc.cameraEnvironment.w > 0.0;
}

float environmentLightPowerEstimate() {
  if (!environmentLightEnabled()) {
    return 0.0;
  }
  if (hdrEnvironmentValid() && environmentLightPower.x > 0.0) {
    return environmentLightPower.x;
  }
  vec3 meanRadiance =
      (lightingEnvironment(vec3(0.0, 1.0, 0.0), 0.0) +
       lightingEnvironment(vec3(1.0, 0.0, 0.0), 0.0) +
       lightingEnvironment(vec3(0.0, -1.0, 0.0), 0.0)) /
      3.0;
  return max(luminance(meanRadiance) * 12.566370614359172, 0.0);
}

float sunDiskAngularRadius() {
  return abs(pc.lightDirectionAmbient.w);
}

float sunDiskSolidAngle() {
  float radius = sunDiskAngularRadius();
  return radius > 0.0
             ? 6.283185307179586 * (1.0 - cos(radius))
             : 0.0;
}

bool sunDiskEnabled() {
  return integratorFlag(25u) && sunDiskAngularRadius() > 0.0 &&
         pc.lightColorIntensity.w > 0.0 &&
         max3(max(pc.lightColorIntensity.rgb, vec3(0.0))) > 0.0;
}

bool sunDiskCastsShadow() {
  return pc.lightDirectionAmbient.w >= 0.0;
}

vec3 evaluateSunDisk(vec3 direction) {
  if (!sunDiskEnabled()) {
    return vec3(0.0);
  }
  vec3 axis = safeNormalize(
      pc.lightDirectionAmbient.xyz, vec3(0.0, 1.0, 0.0));
  float radius = sunDiskAngularRadius();
  float cosine = dot(safeNormalize(direction, axis), axis);
  if (cosine < cos(radius)) {
    return vec3(0.0);
  }
  float angularDistance = acos(clamp(cosine, -1.0, 1.0));
  float disk = 1.0 - smoothstep(0.94, 1.0, angularDistance / radius);
  return max(pc.lightColorIntensity.rgb, vec3(0.0)) *
         max(pc.lightColorIntensity.w, 0.0) * disk;
}

float sunDiskPdf(vec3 direction) {
  if (!sunDiskEnabled()) {
    return 0.0;
  }
  vec3 axis = safeNormalize(
      pc.lightDirectionAmbient.xyz, vec3(0.0, 1.0, 0.0));
  float solidAngle = sunDiskSolidAngle();
  return solidAngle > 0.0 &&
                 dot(safeNormalize(direction, axis), axis) >=
                     cos(sunDiskAngularRadius())
             ? 1.0 / solidAngle
             : 0.0;
}

RtLightSample sampleSunDisk(float sampleU, float sampleV) {
  RtLightSample result;
  result.direction = vec3(0.0, 1.0, 0.0);
  result.pdf = 0.0;
  result.radiance = vec3(0.0);
  result.distance = 10000.0;
  result.type = kRtLightSunDisk;
  result.castsShadow = sunDiskCastsShadow();
  result.valid = false;
  if (!sunDiskEnabled()) {
    return result;
  }
  vec3 axis = safeNormalize(
      pc.lightDirectionAmbient.xyz, vec3(0.0, 1.0, 0.0));
  vec3 tangent =
      abs(axis.y) < 0.999
          ? safeNormalize(cross(vec3(0.0, 1.0, 0.0), axis),
                          vec3(1.0, 0.0, 0.0))
          : vec3(1.0, 0.0, 0.0);
  vec3 bitangent = safeNormalize(cross(axis, tangent),
                                 vec3(0.0, 0.0, 1.0));
  float cosine = mix(1.0, cos(sunDiskAngularRadius()),
                     clamp(sampleU, 0.0, 0.99999994));
  float sine = sqrt(max(1.0 - cosine * cosine, 0.0));
  float phi = 6.283185307179586 * clamp(sampleV, 0.0, 0.99999994);
  result.direction = safeNormalize(
      axis * cosine + tangent * (sine * cos(phi)) +
          bitangent * (sine * sin(phi)),
      axis);
  result.pdf = sunDiskPdf(result.direction);
  result.radiance = evaluateSunDisk(result.direction);
  result.valid = result.pdf > 0.0 && max3(result.radiance) > 0.0 &&
                 finite3(result.direction) && finite3(result.radiance);
  return result;
}

float sunDiskPowerEstimate() {
  return sunDiskEnabled()
             ? max(luminance(max(pc.lightColorIntensity.rgb, vec3(0.0))) *
                       max(pc.lightColorIntensity.w, 0.0) *
                       sunDiskSolidAngle(),
                   0.0)
             : 0.0;
}

float emissiveLightPowerEstimate() {
  float power = uintBitsToFloat(emissiveInfo.w);
  return meshLightsValid() && integratorFlag(26u) && !isnan(power) &&
                 !isinf(power)
             ? max(power * max(pc.integrator.z, 0.0), 0.0)
             : 0.0;
}

vec3 lightRegistryProbabilities() {
  bool enabledEnvironment = environmentLightEnabled();
  bool enabledSun = sunDiskEnabled();
  bool enabledEmissive = meshLightsValid() && integratorFlag(26u);
  const float minimumEnabledWeight = 1.0e-6;
  vec3 weights = vec3(
      enabledEnvironment
          ? max(environmentLightPowerEstimate(), minimumEnabledWeight)
          : 0.0,
      enabledSun ? max(sunDiskPowerEstimate(), minimumEnabledWeight) : 0.0,
      enabledEmissive
          ? max(emissiveLightPowerEstimate(), minimumEnabledWeight)
          : 0.0);
  float maximumWeight = max3(weights);
  if (!(maximumWeight > 0.0) || isnan(maximumWeight) ||
      isinf(maximumWeight)) {
    return vec3(0.0);
  }
  vec3 scaledWeights = weights / maximumWeight;
  float scaledTotal = scaledWeights.x + scaledWeights.y + scaledWeights.z;
  return scaledTotal > 0.0 && !isnan(scaledTotal) && !isinf(scaledTotal)
             ? scaledWeights / scaledTotal
             : vec3(0.0);
}

RtLightSample sampleLightRegistry(
    vec3 source, float environmentLod, float familySample,
    float sample0, float sample1, float sample2, float sample3) {
  RtLightSample result;
  result.direction = vec3(0.0, 1.0, 0.0);
  result.pdf = 0.0;
  result.radiance = vec3(0.0);
  result.distance = 10000.0;
  result.type = kRtLightEnvironment;
  result.castsShadow = true;
  result.valid = false;
  vec3 probabilities = lightRegistryProbabilities();
  float family = clamp(familySample, 0.0, 0.99999994);
  if (family < probabilities.x) {
    EnvironmentSample environmentSample = sampleEnvironment(
        sample0, sample1, sample2, sample3);
    result.direction = environmentSample.direction;
    result.pdf = probabilities.x * environmentSample.pdf;
    result.radiance = lightingEnvironment(result.direction, environmentLod);
    result.type = kRtLightEnvironment;
    result.castsShadow = environmentSampleCastsShadow(result.direction);
    result.valid = environmentSample.valid && result.pdf > 0.0 &&
                   max3(result.radiance) > 0.0;
    return result;
  }
  if (family < probabilities.x + probabilities.y) {
    result = sampleSunDisk(sample0, sample1);
    result.pdf *= probabilities.y;
    result.valid = result.valid && result.pdf > 0.0;
    return result;
  }
  if (probabilities.z > 0.0) {
    MeshLightSample meshSample = sampleMeshLight(
        source, sample0, sample1, sample2, sample3);
    result.direction = meshSample.direction;
    result.pdf = probabilities.z * meshSample.pdf;
    result.radiance = meshSample.radiance * max(pc.integrator.z, 0.0);
    result.distance = meshSample.distance;
    result.type = kRtLightEmissiveTriangle;
    result.castsShadow = true;
    result.valid = meshSample.valid && result.pdf > 0.0 &&
                   max3(result.radiance) > 0.0;
  }
  return result;
}

float projectedDepth(vec3 worldPosition) {
  vec4 clip = pc.viewProj * vec4(worldPosition, 1.0);
  if (!finite4(clip) || abs(clip.w) <= 1.0e-7) {
    return 1.0;
  }
  float depth = clip.z / clip.w;
  return depth == depth && abs(depth) <= 65504.0
             ? clamp(depth, 0.0, 1.0)
             : 1.0;
}

void tracePrimary(vec3 origin, vec3 direction, RayCone cone) {
  payload.baseColor = vec3(0.0);
  payload.t = -1.0;
  payload.shadingNormal = vec3(0.0, 1.0, 0.0);
  payload.ggxAlpha = 1.0;
  payload.geometricNormal = vec3(0.0, 1.0, 0.0);
  payload.ior = 1.5;
  payload.f0 = vec3(0.04);
  payload.transmission = 0.0;
  payload.emission = vec3(0.0);
  payload.opacity = 0.0;
  payload.attenuation = vec4(1.0, 1.0, 1.0, 0.0);
  payload.status = uvec4(0u);
  payload.hitData = vec4(0.0);
  payload.rayCone = vec2(max(cone.width, 0.0),
                         max(cone.spreadAngle, 0.0));
  traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, 0xff, 0, 1, 0, origin,
              0.0, direction, 10000.0, 0);
}

vec3 packedPosition(uint vertex, bool previous) {
  uint base = vertex * 3u;
  return previous
             ? vec3(previousPositions[base + 0u],
                    previousPositions[base + 1u],
                    previousPositions[base + 2u])
             : vec3(positions[base + 0u], positions[base + 1u],
                    positions[base + 2u]);
}

vec4 motionVector(vec2 currentUv, vec3 previousWorld, bool valid) {
  if (!valid || motionInfo.x == 0u) {
    return vec4(0.0, 0.0, 1.0, 0.0);
  }
  vec4 previousClip = previousViewProj * vec4(previousWorld, 1.0);
  if (!finite4(previousClip) || !(previousClip.w > 1.0e-6)) {
    return vec4(0.0, 0.0, 1.0, 0.0);
  }
  vec2 previousNdc = previousClip.xy / previousClip.w;
  // previousViewProj is pre-converted by glMvpToVulkan(), so its NDC Y already
  // maps directly to the top-left-origin storage-image UV convention.
  vec2 previousUv = previousNdc * 0.5 + 0.5;
  bool inside = all(greaterThanEqual(previousUv, vec2(0.0))) &&
                all(lessThanEqual(previousUv, vec2(1.0)));
  if (!inside) {
    return vec4(0.0, 0.0, 1.0, 0.0);
  }
  vec2 motionPixels =
      (previousUv - currentUv) * vec2(pc.sizeMode.xy);
  return vec4(motionPixels, 0.0, 1.0);
}

vec4 surfaceMotion(uint primitive, uint instanceId, vec2 barycentrics,
                   vec2 currentUv) {
  uint i0 = indices[primitive * 3u + 0u];
  uint i1 = indices[primitive * 3u + 1u];
  uint i2 = indices[primitive * 3u + 2u];
  float w0 = 1.0 - barycentrics.x - barycentrics.y;
  bool sceneMotionValid =
      motionInfo.y != 0u && instanceMotion[instanceId].metadata.x != 0u;
  vec3 previousLocal =
      packedPosition(i0, sceneMotionValid) * w0 +
      packedPosition(i1, sceneMotionValid) * barycentrics.x +
      packedPosition(i2, sceneMotionValid) * barycentrics.y;
  vec3 previousWorld =
      ((sceneMotionValid
            ? instanceMotion[instanceId].previousTransform
            : instanceMotion[instanceId].currentTransform) *
       vec4(previousLocal, 1.0)).xyz;
  return motionVector(currentUv, previousWorld, true);
}

// NVIDIA DLSS-RR Programming Guide 4.2.1. Convert material F0 into the
// environment-integrated specular-albedo guide expected by RR.
vec3 rrSpecularAlbedo(vec3 specularColor, float rrRoughness,
                      float noV) {
  noV = abs(noV);
  rrRoughness = clamp(rrRoughness, 0.0, 1.0);
  float alpha = rrRoughness * rrRoughness;
  float noV2 = noV * noV;
  float noV3 = noV2 * noV;
  float alpha2 = alpha * alpha;
  float alpha3 = alpha2 * alpha;

  float biasNumerator =
      (0.99044 - 1.28514 * noV) +
      alpha * (1.29678 - 0.755907 * noV);
  float biasDenominator =
      (1.0 + 2.92338 * noV + 59.4188 * noV3) +
      alpha * (20.3225 - 27.0302 * noV + 222.592 * noV3) +
      alpha3 * (121.563 + 626.13 * noV + 316.627 * noV3);
  float scaleNumerator =
      (0.0365463 + 3.32707 * noV) +
      alpha * (9.0632 - 9.04756 * noV);
  float scaleDenominator =
      (1.0 + 3.59685 * noV2 - 1.36772 * noV3) +
      alpha * (9.04401 - 16.3174 * noV2 + 9.22949 * noV3) +
      alpha3 * (5.56589 + 19.7886 * noV2 - 20.2123 * noV3);

  float bias = biasNumerator / max(biasDenominator, 1.0e-6);
  float scale = scaleNumerator / max(scaleDenominator, 1.0e-6);
  bias *= clamp(specularColor.g * 50.0, 0.0, 1.0);
  return specularColor * max(scale, 0.0) + vec3(max(bias, 0.0));
}

struct PrimaryAovProbe {
  vec4 geometry;
  vec4 shading;
  vec4 diffuseAlbedo;
  vec4 specularAlbedo;
  vec4 motion;
  vec4 emission;
  vec4 transparency;
  float deviceDepth;
  float hitDistance;
  float specularHitDistance;
  float transparencyAndComposition;
  float reactiveMask;
  float guideValidity;
  uint guidePolicy;
  bool neutralizeRrGuides;
  bool opaqueHit;
};

PrimaryAovProbe probePrimaryAov(vec3 cameraOrigin, vec3 direction,
                                vec2 currentUv) {
  PrimaryAovProbe result;
  result.geometry = vec4(0.0, 0.0, 1.0, 0.0);
  result.shading = vec4(0.0, 0.0, 1.0, 1.0);
  result.diffuseAlbedo = vec4(0.0);
  result.specularAlbedo = vec4(0.0);
  result.motion = vec4(0.0, 0.0, 1.0, 0.0);
  result.emission = vec4(0.0);
  result.transparency = vec4(0.0);
  result.deviceDepth = 1.0;
  result.hitDistance = 0.0;
  result.specularHitDistance = 0.0;
  result.transparencyAndComposition = 0.0;
  result.reactiveMask = 0.0;
  result.guideValidity = 0.0;
  result.guidePolicy = kTransparentGuidePolicyV1;
  result.neutralizeRrGuides = true;
  result.opaqueHit = false;

  vec3 origin = cameraOrigin;
  RayCone cone = initialRayCone(currentUv, direction);
  float remaining = 1.0;
  PrimaryPayload guidePayload;
  vec3 guideHitPosition = cameraOrigin;
  RayCone guideCone = cone;
  bool guidePayloadValid = false;
  uint coverageLayerCount = 0u;
  bool guidePhysicalTransmission = false;
  for (uint layer = 0u; layer < 24u; ++layer) {
    tracePrimary(origin, direction, cone);
    if (payload.status.x == 0u || !(payload.t >= 0.0)) {
      break;
    }
    float opacity = clamp(payload.opacity, 0.0, 1.0);
    bool blend = (payload.status.z & kMaterialBlend) != 0u &&
                  opacity < 0.995;
    vec3 hitPosition = origin + direction * payload.t;
    float physicalTransmission = clamp(payload.transmission, 0.0, 1.0);
    if (!guidePayloadValid &&
        (kTransparentGuidePolicyV1 ==
             kTransparentGuidePolicyFrontCoverage ||
         !blend)) {
      guidePayload = payload;
      guideHitPosition = hitPosition;
      guideCone = cone;
      guidePhysicalTransmission = physicalTransmission > 0.0;
      guidePayloadValid = true;
    }
    if (physicalTransmission > 0.0) {
      result.transparencyAndComposition = max(
          result.transparencyAndComposition, physicalTransmission);
      result.reactiveMask = max(result.reactiveMask,
                                physicalTransmission);
    }
    if (blend) {
      ++coverageLayerCount;
      float coverageComposition =
          clamp(4.0 * opacity * (1.0 - opacity), 0.0, 1.0);
      result.transparencyAndComposition = max(
          result.transparencyAndComposition, coverageComposition);
      result.reactiveMask = max(result.reactiveMask,
                                coverageComposition);
      vec3 transparentSignal =
          max(payload.baseColor, vec3(0.0)) +
          max(payload.emission, vec3(0.0)) *
              max(pc.integrator.z, 0.0);
      result.transparency.rgb +=
          remaining * opacity * transparentSignal;
      result.transparency.a += remaining * opacity;
      remaining *= 1.0 - opacity;
      if (remaining <= 0.01) {
        break;
      }
      vec3 transparentNg = safeNormalize(
          payload.geometricNormal, vec3(0.0, 1.0, 0.0));
      origin = offsetRayOrigin(hitPosition, transparentNg, direction);
      cone = propagateRayCone(cone, payload.t, 3u, 0.0, 1.0);
      continue;
    }

    if (!guidePayloadValid) {
      guidePayload = payload;
      guideHitPosition = hitPosition;
      guideCone = cone;
      guidePhysicalTransmission = physicalTransmission > 0.0;
      guidePayloadValid = true;
      result.guidePolicy = kTransparentGuidePolicyOpaqueBehind;
    }
    break;
  }

  if (guidePayloadValid) {
    payload = guidePayload;
    result.opaqueHit = true;
    vec3 geometricNormal = safeNormalize(
        payload.geometricNormal, vec3(0.0, 1.0, 0.0));
    vec3 shadingNormal =
        safeNormalize(payload.shadingNormal, geometricNormal);
    if (dot(shadingNormal, geometricNormal) < 0.0) {
      shadingNormal = -shadingNormal;
    }
    float hitDistance = length(guideHitPosition - cameraOrigin);
    vec4 centerFarWorldH =
        pc.invViewProj * vec4(0.0, 0.0, 1.0, 1.0);
    vec3 centerFarWorld =
        centerFarWorldH.xyz / max(abs(centerFarWorldH.w), 1.0e-6);
    vec3 cameraForward = safeNormalize(
        centerFarWorld - cameraOrigin, vec3(0.0, 0.0, -1.0));
    float viewZ =
        hitDistance * max(dot(direction, cameraForward), 0.0);
    result.hitDistance = hitDistance;
    result.geometry = vec4(geometricNormal, viewZ);
    float ggxAlpha = clamp(payload.ggxAlpha, 0.0, 1.0);
    float rrRoughness = sqrt(ggxAlpha);
    result.shading = vec4(shadingNormal, rrRoughness);
    bool metal = (payload.status.y & 1u) != 0u;
    bool predefinedMetal = (payload.status.y & 2u) != 0u;
    bool physicalTransmission = payload.transmission > 0.0;
    vec3 reflectionTint =
        predefinedMetal
            ? clamp(payload.baseColor, vec3(0.0), vec3(1.0))
            : vec3(1.0);
    result.diffuseAlbedo =
        vec4(metal || physicalTransmission ? vec3(0.0)
                   : clamp(payload.baseColor, vec3(0.0), vec3(1.0)),
             1.0);
    result.specularAlbedo =
        vec4(reflectionTint *
                 rrSpecularAlbedo(
                     clamp(payload.f0, vec3(0.0), vec3(0.99)),
                     rrRoughness,
                     dot(shadingNormal, -direction)),
             0.0);
    result.emission =
        vec4(max(payload.emission, vec3(0.0)) *
                 max(pc.integrator.z, 0.0),
             1.0);
    result.deviceDepth = projectedDepth(guideHitPosition);
    uint primitive = payload.status.w - 1u;
    uint instanceId = floatBitsToUint(payload.hitData.z);
    result.motion =
        surfaceMotion(primitive, instanceId, payload.hitData.xy, currentUv);
    result.guideValidity = 1.0;
    if (coverageLayerCount > 1u || guidePhysicalTransmission ||
        result.motion.w < 0.5) {
      result.guidePolicy = kTransparentGuidePolicyConservativeInvalid;
      result.guideValidity = 0.0;
      result.reactiveMask = 1.0;
      result.motion.z = 1.0;
    }
    result.neutralizeRrGuides = result.guideValidity < 0.5;
    if (integratorFlag(31u) && !guidePhysicalTransmission &&
        !result.neutralizeRrGuides) {
      vec3 reflectedDirection =
          safeNormalize(reflect(direction, shadingNormal),
                         reflect(direction, geometricNormal));
      vec3 reflectedOrigin = offsetRayOrigin(
          guideHitPosition, geometricNormal, reflectedDirection);
      RayCone reflectedCone = propagateRayCone(
          guideCone, payload.t, 1u, ggxAlpha, 1.0);
      tracePrimary(reflectedOrigin, reflectedDirection, reflectedCone);
      if (payload.status.x != 0u && payload.t >= 0.0) {
        vec3 reflectedHitPosition =
            reflectedOrigin + reflectedDirection * payload.t;
        result.specularHitDistance =
            length(reflectedHitPosition - guideHitPosition);
      }
    }
    result.specularAlbedo.w = result.specularHitDistance;
    if (result.neutralizeRrGuides) {
      result.shading = vec4(0.0, 0.0, 1.0, 1.0);
      result.diffuseAlbedo = vec4(0.0);
      result.specularAlbedo = vec4(0.0);
      result.specularHitDistance = 0.0;
    }
  } else {
    result.motion =
        motionVector(currentUv, cameraOrigin + direction * 10000.0, true);
  }
  result.transparencyAndComposition = clamp(
      result.transparencyAndComposition, 0.0, 1.0);
  result.reactiveMask = clamp(result.reactiveMask, 0.0, 1.0);
  result.guideValidity = clamp(result.guideValidity, 0.0, 1.0);
  result.transparency =
      clamp(result.transparency, vec4(0.0), vec4(65504.0));
  return result;
}

void clearTemporalTransparencyMasks(ivec2 pixel) {
  if (outputEnabled(kOutputTransparencyAndComposition)) {
    imageStore(outputTransparencyAndComposition, pixel, vec4(0.0));
  }
  if (outputEnabled(kOutputReactiveMask)) {
    imageStore(outputReactiveMask, pixel, vec4(0.0));
  }
  if (outputEnabled(kOutputGuideValidity)) {
    imageStore(outputGuideValidity, pixel, vec4(0.0));
  }
}

void storeSurfaceAovs(ivec2 pixel, PrimaryAovProbe probe) {
  if (aovOutputEnabled(kAovGeometry)) {
    imageStore(outputAov, ivec3(pixel, kAovGeometry), probe.geometry);
  }
  if (aovOutputEnabled(kAovShading)) {
    imageStore(outputAov, ivec3(pixel, kAovShading), probe.shading);
  }
  if (aovOutputEnabled(kAovDiffuseAlbedo)) {
    imageStore(outputAov, ivec3(pixel, kAovDiffuseAlbedo),
               probe.diffuseAlbedo);
  }
  if (aovOutputEnabled(kAovSpecularAlbedo)) {
    imageStore(outputAov, ivec3(pixel, kAovSpecularAlbedo),
               probe.specularAlbedo);
  }
  if (aovOutputEnabled(kAovMotion)) {
    imageStore(outputAov, ivec3(pixel, kAovMotion), probe.motion);
  }
  if (aovOutputEnabled(kAovEmission)) {
    imageStore(outputAov, ivec3(pixel, kAovEmission), probe.emission);
  }
  if (aovOutputEnabled(kAovTransparency)) {
    imageStore(outputAov, ivec3(pixel, kAovTransparency),
               probe.transparency);
  }
  if (aovOutputEnabled(kAovSpecularHitDistance)) {
    imageStore(outputAov, ivec3(pixel, kAovSpecularHitDistance),
               vec4(probe.specularHitDistance));
  }
  if (outputEnabled(kOutputRrMotion)) {
    imageStore(outputRrMotion, pixel, probe.motion);
  }
  if (outputEnabled(kOutputRrSpecularHitDistance)) {
    imageStore(outputRrSpecularHitDistance, pixel,
               vec4(probe.specularHitDistance));
  }
  if (outputEnabled(kOutputRrDiffuseAlbedo)) {
    imageStore(outputRrDiffuseAlbedo, pixel, probe.diffuseAlbedo);
  }
  if (outputEnabled(kOutputRrSpecularAlbedo)) {
    imageStore(outputRrSpecularAlbedo, pixel, probe.specularAlbedo);
  }
  if (outputEnabled(kOutputRrNormalRoughness)) {
    imageStore(outputRrNormalRoughness, pixel, probe.shading);
  }
  if (outputEnabled(kOutputTransparencyAndComposition)) {
    imageStore(outputTransparencyAndComposition, pixel,
               vec4(probe.transparencyAndComposition));
  }
  if (outputEnabled(kOutputReactiveMask)) {
    imageStore(outputReactiveMask, pixel, vec4(probe.reactiveMask));
  }
  if (outputEnabled(kOutputGuideValidity)) {
    imageStore(outputGuideValidity, pixel, vec4(probe.guideValidity));
  }
}

void main() {
  uvec2 pixel = gl_LaunchIDEXT.xy;
  if (pixel.x >= pc.sizeMode.x || pixel.y >= pc.sizeMode.y) {
    return;
  }

  vec3 cameraOrigin = pc.cameraEnvironment.xyz;
  clearTemporalTransparencyMasks(ivec2(pixel));
  bool temporalReconstruction = pc.cameraJitter.z > 0.5;
  vec2 temporalPixelOffset =
      // Streamline receives +jitter. The inverse projection is unjittered,
      // so subtract it here to match NVIDIA's clip-space jitter convention.
      vec2(0.5) -
      clamp(pc.cameraJitter.xy, vec2(-0.5), vec2(0.5));
  vec2 primaryUv =
      (vec2(pixel) +
       (temporalReconstruction ? temporalPixelOffset : vec2(0.5))) /
      vec2(pc.sizeMode.xy);
  vec2 centerNdc =
      vec2(primaryUv.x * 2.0 - 1.0, 1.0 - primaryUv.y * 2.0);
  vec4 centerFarWorldH =
      pc.invViewProj * vec4(centerNdc, 1.0, 1.0);
  vec3 centerFarWorld =
      centerFarWorldH.xyz / max(abs(centerFarWorldH.w), 1.0e-6);
  vec3 centerDirection =
      safeNormalize(centerFarWorld - cameraOrigin,
                    vec3(0.0, 0.0, -1.0));
  PrimaryAovProbe aovProbe =
      probePrimaryAov(cameraOrigin, centerDirection, primaryUv);
  storeSurfaceAovs(ivec2(pixel), aovProbe);
  uint debugMode = pc.sizeMode.z;
  uint materialDebug = (pc.sampling.w >> 16u) & 0xffu;
  if (debugMode != 0u || materialDebug != 0u) {
    vec2 uv = primaryUv;
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 farWorldH = pc.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 farWorld =
        farWorldH.xyz / max(abs(farWorldH.w), 1.0e-6);
    vec3 direction =
        safeNormalize(farWorld - cameraOrigin, vec3(0.0, 0.0, -1.0));
    tracePrimary(cameraOrigin, direction, initialRayCone(uv, direction));

    float depth = 1.0;
    float alpha = 0.0;
    if (payload.status.x != 0u && payload.t >= 0.0) {
      depth = projectedDepth(cameraOrigin + direction * payload.t);
      alpha = 1.0;
    }
    vec3 debugColor =
        finite3(payload.baseColor)
            ? max(payload.baseColor, vec3(0.0))
            : vec3(0.0);
    imageStore(outputImage, ivec2(pixel), vec4(debugColor, alpha));
    imageStore(outputDepth, ivec2(pixel), vec4(aovProbe.deviceDepth));
    if (aovOutputEnabled(kAovDiffuseRadiance)) {
      imageStore(outputAov, ivec3(pixel, kAovDiffuseRadiance),
                 vec4(0.0, 0.0, 0.0,
                      aovProbe.hitDistance));
    }
    if (aovOutputEnabled(kAovSpecularRadiance)) {
      imageStore(outputAov, ivec3(pixel, kAovSpecularRadiance),
                 vec4(0.0, 0.0, 0.0,
                      aovProbe.hitDistance));
    }
    if (outputEnabled(kOutputStatistics)) {
      imageStore(outputStatistics, ivec2(pixel),
                 vec4(0.0, aovProbe.opaqueHit ? 1.0 : 0.0, 1.0,
                      aovProbe.geometry.w));
    }
    return;
  }

  uint dispatchSamples = max(pc.sampling.y, 1u);
  uint maxBounces = clamp(pc.sizeMode.w, 1u, 64u);
  bool rrEnabled = (pc.sampling.w & 1u) != 0u;
  uint rrStart = clamp((pc.sampling.w >> 1u) & 0x7fu, 1u,
                       maxBounces);
  bool analyticLightsEnabled = integratorFlag(25u);
  bool emissiveSurfacesEnabled = integratorFlag(26u);
  const uint kLightSamplingBsdfOnly = 0u;
  const uint kLightSamplingLightOnly = 1u;
  const uint kLightSamplingCombined = 2u;
  bool neeRequested = integratorFlag(27u);
  bool misRequested = integratorFlag(28u);
  uint lightSamplingMode =
      misRequested
          ? kLightSamplingCombined
          : ((neeRequested || analyticLightsEnabled)
                 ? kLightSamplingLightOnly
                 : kLightSamplingBsdfOnly);
  bool neeEnabled = lightSamplingMode != kLightSamplingBsdfOnly;
  bool misEnabled = lightSamplingMode == kLightSamplingCombined;
  uint lightSamples =
      clamp(uint(round(pc.integrator.w)), 1u, 16u);
  vec3 radianceSum = vec3(0.0);
  vec3 diffuseRadianceSum = vec3(0.0);
  vec3 specularRadianceSum = vec3(0.0);
  float alphaSum = 0.0;
  float luminanceSum = 0.0;
  float luminanceSquaredSum = 0.0;
  float pathLengthSum = 0.0;

  for (uint localSample = 0u; localSample < dispatchSamples;
       ++localSample) {
    uint sampleIndex = pc.sampling.x + localSample;
    PathRngState cameraRng = makePathRng(
        pixel, sampleIndex, 0u, kRngDomainCameraJitter, 0u,
        pc.sampling.z);
    float cameraSampleX = nextRandom(cameraRng);
    float cameraSampleY = nextRandom(cameraRng);
    vec2 jitter =
        temporalReconstruction
            ? temporalPixelOffset
            : vec2(cameraSampleX, cameraSampleY);
    vec2 uv = (vec2(pixel) + jitter) / vec2(pc.sizeMode.xy);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 farWorldH = pc.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 farWorld =
        farWorldH.xyz / max(abs(farWorldH.w), 1.0e-6);
    vec3 origin = cameraOrigin;
    vec3 direction =
        safeNormalize(farWorld - origin, vec3(0.0, 0.0, -1.0));
    RayCone rayCone = initialRayCone(uv, direction);
    vec3 throughput = vec3(1.0);
    vec3 sampleRadiance = vec3(0.0);
    vec3 sampleDiffuseRadiance = vec3(0.0);
    vec3 sampleSpecularRadiance = vec3(0.0);
    bool primaryHit = false;
    uint primaryPathClass = 0u;
    float samplePathLength = 0.0;
    uint diffuseBounces = 0u;
    uint glossyBounces = 0u;
    uint transmissionBounces = 0u;
    uint transparentBounces = 0u;
    float previousBsdfPdf = 0.0;
    bool previousWasDelta = true;
    bool insideSolidMedium = false;
    vec3 mediumAttenuationColor = vec3(1.0);
    float mediumAttenuationDistance = 0.0;

    uint bounce = 0u;
    while (bounce < maxBounces) {
      tracePrimary(origin, direction, rayCone);
      if (payload.status.x == 0u || !(payload.t >= 0.0)) {
        float environmentLod = rayConeEnvironmentLod(rayCone);
        vec3 missRadiance = backgroundEnvironment(direction, environmentLod);
        if (bounce > 0u) {
          vec3 familyProbabilities = lightRegistryProbabilities();
          vec3 environmentRadiance =
              lightingEnvironment(direction, environmentLod);
          vec3 sunRadiance = evaluateSunDisk(direction);
          float environmentWeight = 1.0;
          float sunWeight = 1.0;
          if (!previousWasDelta) {
            float environmentLightPdf =
                familyProbabilities.x * environmentPdf(direction);
            float sunLightPdf =
                familyProbabilities.y * sunDiskPdf(direction);
            if (environmentLightPdf > 0.0) {
              environmentWeight =
                  lightSamplingMode == kLightSamplingLightOnly
                      ? 0.0
                      : (lightSamplingMode == kLightSamplingCombined
                             ? powerHeuristic(previousBsdfPdf,
                                              environmentLightPdf)
                             : 1.0);
            }
            if (sunLightPdf > 0.0) {
              sunWeight = lightSamplingMode == kLightSamplingLightOnly
                              ? 0.0
                              : (lightSamplingMode == kLightSamplingCombined
                                     ? powerHeuristic(previousBsdfPdf,
                                                      sunLightPdf)
                                     : 1.0);
            }
          }
          missRadiance = environmentRadiance * environmentWeight +
                         sunRadiance * sunWeight;
        }
        vec3 missContribution = throughput * missRadiance;
        vec3 clampedMiss = clampContribution(
            missContribution,
            bounce == 0u ? 0.0 : pc.integrator.y);
        sampleRadiance += clampedMiss;
        if (bounce > 0u) {
          if (primaryPathClass == 1u) {
            sampleDiffuseRadiance += clampedMiss;
          } else {
            sampleSpecularRadiance += clampedMiss;
          }
        }
        break;
      }

      vec3 hitPosition = origin + direction * payload.t;
      samplePathLength += 1.0;
      if (insideSolidMedium) {
        throughput *= beerLambertTransmittance(
            mediumAttenuationColor, mediumAttenuationDistance, payload.t);
        if (!finite3(throughput) || max3(throughput) <= 1.0e-8) {
          break;
        }
      }
      float hitOpacity = clamp(
          finite3(vec3(payload.opacity)) ? payload.opacity : 1.0,
          0.0, 1.0);
      bool blendMaterial = (payload.status.z & kMaterialBlend) != 0u;
      if (blendMaterial && hitOpacity < 1.0) {
        PathRngState alphaRng = makePathRng(
            pixel, sampleIndex, bounce, kRngDomainAlphaCoverage,
            transparentBounces, pc.sampling.z);
        float alphaSample = nextRandom(alphaRng);
        if (alphaSample >= hitOpacity) {
          if (transparentBounces >= pc.depthLimits.w) {
            break;
          }
          ++transparentBounces;
          ++bounce;
          // Stochastic alpha coverage: an unaccepted layer contributes no
          // shading and continues along the same ray to reveal layers behind.
          vec3 transparentNg = safeNormalize(
              payload.geometricNormal, vec3(0.0, 1.0, 0.0));
          origin = offsetRayOrigin(hitPosition, transparentNg, direction);
          rayCone = propagateRayCone(
              rayCone, payload.t, 3u, 0.0, 1.0);
          continue;
        }
      }
      vec3 authoredGeometric = safeNormalize(
          payload.geometricNormal, vec3(0.0, 1.0, 0.0));
      bool frontFace = dot(direction, authoredGeometric) < 0.0;
      vec3 geometricNormal =
          frontFace ? authoredGeometric : -authoredGeometric;
      vec3 normal = safeNormalize(payload.shadingNormal,
                                  geometricNormal);
      if (dot(normal, geometricNormal) < 0.0) {
        normal = -normal;
      }
      vec3 view = -direction;
      if (!(dot(normal, view) > 1.0e-5)) {
        normal = geometricNormal;
      }
      vec3 baseColor =
          finite3(payload.baseColor)
              ? clamp(payload.baseColor, vec3(0.0), vec3(1.0))
              : vec3(0.0);
      vec3 f0 =
          finite3(payload.f0)
              ? clamp(payload.f0, vec3(0.0), vec3(0.99))
              : vec3(0.04);
      float ggxAlpha = clamp(payload.ggxAlpha, 0.0, 1.0);
      float transmission = clamp(payload.transmission, 0.0, 1.0);
      float ior = clamp(payload.ior, 1.0001, 99.0);
      bool metal = (payload.status.y & 1u) != 0u;
      bool predefinedMetal = (payload.status.y & 2u) != 0u;
      bool thinWalled = (payload.status.y & 4u) != 0u;
      vec3 attenuationColor =
          finite3(payload.attenuation.rgb)
              ? clamp(payload.attenuation.rgb, vec3(1.0e-6), vec3(1.0))
              : vec3(1.0);
      float attenuationDistance =
          !isnan(payload.attenuation.w) && !isinf(payload.attenuation.w)
              ? max(payload.attenuation.w, 0.0)
              : 0.0;
      vec3 reflectionTint =
          predefinedMetal ? baseColor : vec3(1.0);
      vec3 emission =
          finite3(payload.emission)
              ? max(payload.emission, vec3(0.0))
              : vec3(0.0);
      emission *=
          emissiveSurfacesEnabled ? max(pc.integrator.z, 0.0) : 0.0;

      if (bounce == 0u) {
        primaryHit = true;
      }
      float emissionWeight = 1.0;
      if (bounce > 0u && !previousWasDelta &&
          payload.status.w > 0u && meshLightsValid()) {
        float lightPdf = lightRegistryProbabilities().z * meshLightPdf(
            payload.status.w - 1u, origin, hitPosition);
        if (lightPdf > 0.0) {
          if (lightSamplingMode == kLightSamplingLightOnly) {
            emissionWeight = 0.0;
          } else if (lightSamplingMode == kLightSamplingCombined) {
            emissionWeight =
                powerHeuristic(previousBsdfPdf, lightPdf);
          }
        }
      }
      vec3 emissionContribution = clampContribution(
          throughput * emission * emissionWeight, pc.integrator.y);
      sampleRadiance += emissionContribution;
      if (bounce > 0u) {
        if (primaryPathClass == 1u) {
          sampleDiffuseRadiance += emissionContribution;
        } else {
          sampleSpecularRadiance += emissionContribution;
        }
      }

      vec3 registryDirectSum = vec3(0.0);
      vec3 registryDiffuseSum = vec3(0.0);
      vec3 registrySpecularSum = vec3(0.0);
      RayCone directEnvironmentCone = propagateRayCone(
          rayCone, payload.t, 1u, ggxAlpha, 1.0);
      float directEnvironmentLod =
          rayConeEnvironmentLod(directEnvironmentCone);
      for (uint lightSample = 0u;
           neeEnabled && lightSample < lightSamples; ++lightSample) {
        PathRngState registryRng = makePathRng(
            pixel, sampleIndex, bounce, kRngDomainLightRegistry,
            lightSample, pc.sampling.z);
        float familySample = nextRandom(registryRng);
        float registrySample0 = nextRandom(registryRng);
        float registrySample1 = nextRandom(registryRng);
        float registrySample2 = nextRandom(registryRng);
        float registrySample3 = nextRandom(registryRng);
        RtLightSample registrySample = sampleLightRegistry(
            hitPosition, directEnvironmentLod, familySample,
            registrySample0, registrySample1, registrySample2,
            registrySample3);
        float registryNoL = max(dot(normal, registrySample.direction), 0.0);
        if (!registrySample.valid || !(registrySample.pdf > 0.0) ||
            !(registryNoL > 0.0)) {
          continue;
        }
        shadowPayload.visibility = 1.0;
        shadowPayload.reserved = 0.0;
        shadowPayload.rayCone = vec2(
            rayConeWidthAtDistance(rayCone, payload.t),
            max(rayCone.spreadAngle, 0.0));
        if (registrySample.castsShadow) {
          vec3 shadowOrigin = offsetRayOrigin(
              hitPosition, geometricNormal, registrySample.direction);
          float shadowDistance =
              registrySample.type == kRtLightEmissiveTriangle
                  ? registrySample.distance * (1.0 - 1.0e-5)
                  : 10000.0;
          if (!(shadowDistance > 0.0)) {
            continue;
          }
          traceRayEXT(
              topLevelAS,
              gl_RayFlagsTerminateOnFirstHitEXT |
                  gl_RayFlagsSkipClosestHitShaderEXT,
              0xff, 0, 1, 1, shadowOrigin, 0.0,
              registrySample.direction, shadowDistance, 1);
        }
        float registryBsdfPdf = 0.0;
        vec3 registryDiffuseBsdf;
        vec3 registrySpecularBsdf;
        evaluateBsdfComponents(
            baseColor, f0, reflectionTint, ggxAlpha, transmission, ior,
            metal, thinWalled, frontFace, normal, view,
            registrySample.direction, registryDiffuseBsdf,
            registrySpecularBsdf, registryBsdfPdf);
        float correction = shadingNormalCorrection(
            geometricNormal, normal, view, registrySample.direction);
        float misWeight =
            misEnabled
                ? powerHeuristic(registrySample.pdf, registryBsdfPdf)
                : 1.0;
        vec3 registryScale =
            throughput * registrySample.radiance *
            (registryNoL * clamp(shadowPayload.visibility, 0.0, 1.0) *
             correction * misWeight / registrySample.pdf);
        registryDiffuseSum += registryScale * registryDiffuseBsdf;
        registrySpecularSum += registryScale * registrySpecularBsdf;
        registryDirectSum +=
            registryScale * (registryDiffuseBsdf + registrySpecularBsdf);
      }
      vec3 registryContribution = clampContribution(
          registryDirectSum / float(lightSamples), pc.integrator.x);
      sampleRadiance += registryContribution;
      if (bounce == 0u) {
        sampleDiffuseRadiance += clampContribution(
            registryDiffuseSum / float(lightSamples), pc.integrator.x);
        sampleSpecularRadiance += clampContribution(
            registrySpecularSum / float(lightSamples), pc.integrator.x);
      } else if (primaryPathClass == 1u) {
        sampleDiffuseRadiance += registryContribution;
      } else {
        sampleSpecularRadiance += registryContribution;
      }

      vec3 probabilities;
      lobeProbabilities(baseColor, f0, metal, transmission, ior,
                        probabilities);
      PathRngState lobeRng = makePathRng(
          pixel, sampleIndex, bounce, kRngDomainLobeSelection, 0u,
          pc.sampling.z);
      PathRngState directionRng = makePathRng(
          pixel, sampleIndex, bounce, kRngDomainDirection, 0u,
          pc.sampling.z);
      float lobeSample = nextRandom(lobeRng);
      float sampleU = nextRandom(directionRng);
      float sampleV = nextRandom(directionRng);
      vec3 nextDirection = vec3(0.0);
      vec3 sampleWeight = vec3(0.0);
      float nextBsdfPdf = 0.0;
      bool nextWasDelta = false;
      uint nextLobe = 0u;

      float etaIncident = frontFace ? 1.0 : ior;
      float etaTransmitted = frontFace ? ior : 1.0;
      float eta = etaIncident / etaTransmitted;
      if (lobeSample < probabilities.x) {
        if (diffuseBounces >= pc.depthLimits.x) {
          break;
        }
        ++diffuseBounces;
        if (bounce == 0u) {
          primaryPathClass = 1u;
        }
        nextDirection = cosineHemisphere(normal, sampleU, sampleV);
        float pdf = 0.0;
        vec3 value = evaluateBsdf(
            baseColor, f0, reflectionTint, ggxAlpha, transmission, ior,
            metal, thinWalled, frontFace, normal, view, nextDirection, pdf);
        if (!(pdf > 0.0)) {
          break;
        }
        nextBsdfPdf = pdf;
        sampleWeight =
            value * max(dot(normal, nextDirection), 0.0) / pdf;
        nextLobe = 0u;
      } else {
        float interfaceProbability = probabilities.y + probabilities.z;
        if (!(interfaceProbability > 0.0)) {
          break;
        }
        float interfaceSample = clamp(
            (lobeSample - probabilities.x) / interfaceProbability,
            0.0, 0.99999994);
        if (!metal && thinWalled && transmission > 0.0) {
          float singleFresnel = dielectricFresnel(
              dot(normal, view), etaIncident, etaTransmitted);
          float fresnel = thinWalledCombinedFresnel(singleFresnel);
          float reflectionWeight = fresnel;
          float transmissionWeight = transmission * (1.0 - fresnel);
          float interfaceTotal = reflectionWeight + transmissionWeight;
          float conditionalReflection =
              interfaceTotal > 0.0 ? reflectionWeight / interfaceTotal : 1.0;
          bool reflectEvent = interfaceSample < conditionalReflection;
          float selectionProbability =
              interfaceProbability *
              (reflectEvent ? conditionalReflection
                            : 1.0 - conditionalReflection);
          if (!(selectionProbability > 0.0)) {
            break;
          }
          if (reflectEvent) {
            if (glossyBounces >= pc.depthLimits.y) {
              break;
            }
            ++glossyBounces;
            nextDirection = reflect(-view, normal);
            sampleWeight = vec3(reflectionWeight / selectionProbability);
            nextLobe = 1u;
          } else {
            if (transmissionBounces >= pc.depthLimits.z) {
              break;
            }
            ++transmissionBounces;
            nextDirection = -view;
            sampleWeight = vec3(transmissionWeight / selectionProbability);
            nextLobe = 2u;
          }
          if (bounce == 0u) {
            primaryPathClass = 2u;
          }
          nextBsdfPdf = selectionProbability;
          nextWasDelta = true;
        } else {
          bool finiteInterface = ggxAlpha > kDeltaMirrorAlpha;
          vec3 halfVector = normal;
          if (finiteInterface) {
            bool validVndf = false;
            halfVector = sampleGgxVndf(
                normal, view, ggxAlpha, sampleU, sampleV, validVndf);
            if (!validVndf) {
              break;
            }
          }
          float voH = dot(view, halfVector);
          if (!(voH > 0.0)) {
            break;
          }
          float sinTSquared =
              eta * eta * max(0.0, 1.0 - voH * voH);
          bool canRefract = sinTSquared < 1.0;
          vec3 fresnel = metal
                             ? fresnelSchlick(f0, voH)
                             : vec3(canRefract
                                        ? dielectricFresnel(
                                              voH, etaIncident,
                                              etaTransmitted)
                                        : 1.0);
          float scalarFresnel = max3(fresnel);
          float reflectionWeight = metal ? 1.0 : scalarFresnel;
          float transmissionWeight =
              metal || !canRefract
                  ? 0.0
                  : transmission * (1.0 - scalarFresnel);
          float interfaceTotal = reflectionWeight + transmissionWeight;
          if (!(interfaceTotal > 0.0)) {
            break;
          }
          float conditionalReflection = reflectionWeight / interfaceTotal;
          bool reflectEvent = interfaceSample < conditionalReflection;
          if (reflectEvent) {
            if (glossyBounces >= pc.depthLimits.y) {
              break;
            }
            ++glossyBounces;
            nextDirection = safeNormalize(
                2.0 * voH * halfVector - view, geometricNormal);
            if (!(dot(normal, nextDirection) > 0.0)) {
              break;
            }
            nextLobe = 1u;
          } else {
            if (!canRefract || transmissionBounces >= pc.depthLimits.z) {
              break;
            }
            ++transmissionBounces;
            float cosT = sqrt(max(0.0, 1.0 - sinTSquared));
            nextDirection = safeNormalize(
                -eta * view + (eta * voH - cosT) * halfVector,
                -geometricNormal);
            if (!(dot(normal, nextDirection) < 0.0)) {
              break;
            }
            nextLobe = 2u;
          }
          if (bounce == 0u) {
            primaryPathClass = 2u;
          }
          if (!finiteInterface) {
            float eventProbability =
                interfaceProbability *
                (reflectEvent ? conditionalReflection
                              : 1.0 - conditionalReflection);
            if (!(eventProbability > 0.0)) {
              break;
            }
            nextBsdfPdf = eventProbability;
            if (reflectEvent) {
              sampleWeight = reflectionTint * fresnel / eventProbability;
            } else {
              float etaScale = eta * eta;
              sampleWeight =
                  vec3(transmissionWeight * etaScale / eventProbability);
            }
            nextWasDelta = true;
          } else if (reflectEvent) {
            float pdf = 0.0;
            vec3 value = evaluateBsdf(
                baseColor, f0, reflectionTint, ggxAlpha, transmission, ior,
                metal, thinWalled, frontFace, normal, view, nextDirection,
                pdf);
            if (!(pdf > 0.0)) {
              break;
            }
            nextBsdfPdf = pdf;
            sampleWeight =
                value * abs(dot(normal, nextDirection)) / pdf;
          } else {
            float pdf = 0.0;
            vec3 value = evaluateMicrofacetTransmission(
                baseColor, ggxAlpha, transmission, ior, frontFace,
                normal, view, nextDirection, pdf);
            if (!(pdf > 0.0)) {
              break;
            }
            nextBsdfPdf = pdf;
            sampleWeight =
                value * abs(dot(normal, nextDirection)) / pdf;
          }
        }
      }

      float correction = shadingNormalCorrection(
          geometricNormal, normal, view, nextDirection);
      throughput *= sampleWeight * correction;
      if (!finite3(throughput) || !finite3(nextDirection) ||
          max3(throughput) <= 1.0e-5) {
        break;
      }
      if (nextLobe == 2u && !thinWalled) {
        if (frontFace) {
          insideSolidMedium = true;
          mediumAttenuationColor = attenuationColor;
          mediumAttenuationDistance = attenuationDistance;
        } else {
          insideSolidMedium = false;
          mediumAttenuationColor = vec3(1.0);
          mediumAttenuationDistance = 0.0;
        }
      }
      previousBsdfPdf = nextBsdfPdf;
      previousWasDelta = nextWasDelta;
      uint completedBounces = bounce + 1u;
      if (rrEnabled && completedBounces >= rrStart &&
          completedBounces < maxBounces) {
        float continuation =
            clamp(max3(throughput), 0.05, 0.95);
        PathRngState rrRng = makePathRng(
            pixel, sampleIndex, bounce, kRngDomainRussianRoulette, 0u,
            pc.sampling.z);
        float rrSample = nextRandom(rrRng);
        if (rrSample >= continuation) {
          break;
        }
        throughput /= continuation;
      }
      rayCone = propagateRayCone(
          rayCone, payload.t, nextLobe, ggxAlpha,
          nextLobe == 2u && thinWalled ? 1.0 : eta);
      origin = offsetRayOrigin(
          hitPosition, geometricNormal, nextDirection);
      direction = nextDirection;
      ++bounce;
    }

    if (!finite3(sampleRadiance)) {
      sampleRadiance = vec3(0.0);
    }
    if (!finite3(sampleDiffuseRadiance)) {
      sampleDiffuseRadiance = vec3(0.0);
    }
    if (!finite3(sampleSpecularRadiance)) {
      sampleSpecularRadiance = vec3(0.0);
    }
    radianceSum += max(sampleRadiance, vec3(0.0));
    diffuseRadianceSum += max(sampleDiffuseRadiance, vec3(0.0));
    specularRadianceSum += max(sampleSpecularRadiance, vec3(0.0));
    float sampleLuminance = luminance(max(sampleRadiance, vec3(0.0)));
    luminanceSum += sampleLuminance;
    luminanceSquaredSum += sampleLuminance * sampleLuminance;
    pathLengthSum += samplePathLength;
    alphaSum +=
        (primaryHit || environmentBackgroundVisible()) ? 1.0 : 0.0;
  }

  float previousSamples = float(pc.sampling.x);
  float totalSamples = previousSamples + float(dispatchSamples);
  vec4 previousOutput =
      pc.sampling.x > 0u
          ? imageLoad(outputImage, ivec2(pixel))
          : vec4(0.0);
  vec4 accumulated = vec4(radianceSum, alphaSum);
  if (pc.sampling.x > 0u) {
    // The target stores straight RGBA for DLSS and still-image export, while
    // progressive accumulation remains coverage-premultiplied.
    vec4 previousPremultiplied = previousOutput;
    previousPremultiplied.rgb *=
        clamp(previousOutput.a, 0.0, 1.0);
    accumulated += previousPremultiplied * previousSamples;
  }
  vec4 outputValue = accumulated / max(totalSamples, 1.0);
  if (outputValue.a > 1.0e-6) {
    outputValue.rgb /= outputValue.a;
  } else {
    outputValue.rgb = vec3(0.0);
  }
  if (!finite3(outputValue.rgb) || !(outputValue.a == outputValue.a)) {
    outputValue = vec4(0.0);
  }
  outputValue = clamp(outputValue, vec4(0.0), vec4(65504.0));
  imageStore(outputImage, ivec2(pixel), outputValue);
  imageStore(outputDepth, ivec2(pixel), vec4(aovProbe.deviceDepth));

  if (aovOutputEnabled(kAovDiffuseRadiance)) {
    vec3 previousDiffuse =
        pc.sampling.x > 0u
            ? imageLoad(outputAov,
                        ivec3(pixel, kAovDiffuseRadiance)).rgb
            : vec3(0.0);
    vec3 diffuseRadiance =
        (previousDiffuse * previousSamples + diffuseRadianceSum) /
        max(totalSamples, 1.0);
    imageStore(
        outputAov, ivec3(pixel, kAovDiffuseRadiance),
        vec4(clamp(diffuseRadiance, vec3(0.0), vec3(65504.0)),
             aovProbe.hitDistance));
  }
  if (aovOutputEnabled(kAovSpecularRadiance)) {
    vec3 previousSpecular =
        pc.sampling.x > 0u
            ? imageLoad(outputAov,
                        ivec3(pixel, kAovSpecularRadiance)).rgb
            : vec3(0.0);
    vec3 specularRadiance =
        (previousSpecular * previousSamples + specularRadianceSum) /
        max(totalSamples, 1.0);
    imageStore(
        outputAov, ivec3(pixel, kAovSpecularRadiance),
        vec4(clamp(specularRadiance, vec3(0.0), vec3(65504.0)),
             aovProbe.hitDistance));
  }

  if (outputEnabled(kOutputStatistics)) {
    vec4 previousStatistics =
        pc.sampling.x > 0u
            ? imageLoad(outputStatistics, ivec2(pixel))
            : vec4(0.0);
    float dispatchCount = float(dispatchSamples);
    float dispatchMean =
        luminanceSum / max(dispatchCount, 1.0);
    float dispatchM2 = max(
        luminanceSquaredSum -
            luminanceSum * luminanceSum / max(dispatchCount, 1.0),
        0.0);
    float previousMean = luminance(previousOutput.rgb);
    float previousM2 =
        max(previousStatistics.x, 0.0) * previousSamples;
    float delta = dispatchMean - previousMean;
    float combinedM2 =
        previousM2 + dispatchM2 +
        (previousSamples > 0.0
             ? delta * delta * previousSamples * dispatchCount /
                   max(totalSamples, 1.0)
             : 0.0);
    float variance = combinedM2 / max(totalSamples, 1.0);
    float averagePathLength =
        (previousStatistics.y * previousSamples + pathLengthSum) /
        max(totalSamples, 1.0);
    imageStore(
        outputStatistics, ivec2(pixel),
        vec4(max(variance, 0.0), max(averagePathLength, 0.0),
             totalSamples, aovProbe.geometry.w));
  }
}
